### Task 3 — Robust Aggregation

```python
# Input: list of runs, each run is a dict with keys 'speed' (float or None) and 'status' (str)
# Status can be 'success' or 'failure' (including OOM)

def aggregate_decoding_speeds(runs):
    successful_speeds = []
    failed_runs = []
    
    for run in runs:
        if run['status'] == 'success':
            if run['speed'] is not None and run['speed'] > 0:
                successful_speeds.append(run['speed'])
            else:
                # Log as a warning but exclude from median
                log_warning(f"Run {run['id']} reported success but invalid speed: {run['speed']}")
        else:
            # Keep failed runs visible for debugging
            failed_runs.append(run)
    
    if len(successful_speeds) < 2:
        return {
            "median_speed": None,
            "status": "Insufficient data",
            "message": "Fewer than 2 successful runs. Cannot compute robust median.",
            "successful_runs": successful_speeds,
            "failed_runs": failed_runs
        }
    
    successful_speeds.sort()
    n = len(successful_speeds)
    if n % 2 == 1:
        median = successful_speeds[n // 2]
    else:
        median = (successful_speeds[n // 2 - 1] + successful_speeds[n // 2]) / 2.0
    
    return {
        "median_speed": median,
        "status": "success",
        "successful_runs": successful_speeds,
        "failed_runs": failed_runs
    }
```

**Reporting if Fewer Than Two Runs Succeed:**
Report `median_speed: null` and explicitly state: "Insufficient successful runs to compute a statistically meaningful median. The following runs failed: [list of failed run details]." Do not average in the failure (0 tok/s) as this distorts the metric.

