### Task 3 — Robust Aggregation

**Pseudocode**

```python
# Input: list of run records, each containing 'speed' and 'status'
# status: 'SUCCESS' or 'FAILURE' (or specific error code)

def aggregate_decode_speeds(runs):
    successful_speeds = []
    failed_runs = []

    for run in runs:
        # Validate record structure
        if not has_valid_keys(run):
            raise ValueError("Malformed run record")
        
        if run['status'] == 'SUCCESS':
            # Ensure speed is a positive number
            if is_positive_number(run['speed']):
                successful_speeds.append(run['speed'])
            else:
                # Treat non-positive speed as data error, log but exclude from median
                failed_runs.append(run)
        else:
            # Record failure explicitly, do not discard
            failed_runs.append(run)

    # Report failures separately to maintain visibility
    report_failures(failed_runs)

    # Compute median only for successful runs
    if len(successful_speeds) >= 2:
        median_speed = compute_median(successful_speeds)
        return median_speed
    else:
        # Handle insufficient data
        return handle_insufficient_data(successful_speeds, failed_runs)

def report_failures(failed_runs):
    for run in failed_runs:
        log_warning(f"Run failed: {run['id']} with status {run['status']}")

def handle_insufficient_data(successful_speeds, failed_runs):
    if len(successful_speeds) == 1:
        # Only one success, cannot compute robust median
        return successful_speeds[0] # Return single value with warning
    else:
        # No successful runs
        return None # Or "N/A"
```

**Reporting Rule for <2 Successful Runs:**
If fewer than two runs succeed (i.e., 0 or 1 success), the median is statistically undefined or unrobust.
*   **0 successes:** Report "No valid data. All runs failed."
*   **1 success:** Report the single value but flag it as "Unreliable: Single data point. Median cannot be computed." Do not report a median.

