### Task 3 — Robust Aggregation
**Pseudocode**
```python
import collections

def validate_and_compute_median(records):
    # 1. Validate records:
    # - Ensure records are tuples of (run_index, success_flag, latency, memory_usage)
    # - Ensure run_index is an integer >= 1
    # - Ensure success_flag is True if latency > 0, False otherwise
    # - Validate that latency is a float
    valid_records = []
    for i, (run, success, latency, mem) in enumerate(records):
        if not isinstance(run, int) or run < 1:
            raise ValueError("Invalid run index")
        if not isinstance(success, bool):
            raise ValueError("Invalid success flag type")
        if not isinstance(latency, (int, float)):
            raise ValueError("Invalid latency type")
        if not isinstance(mem, (int, float)):
            raise ValueError("Invalid memory type")
        
        if success:
            valid_records.append((i, True, latency, mem))
        else:
            valid_records.append((i, False, latency, mem))

    # 2. Keep the failed run visible (as a tuple of its failed run index):
    # (run_index, success_flag, latency, memory_usage)
    failed_run = records[-1] # The last one in the list

    # 3. Compute median for successful runs
    # - Filter valid records where success is True
    # - Sort by latency in descending order (faster first)
    successful_runs = [r for r in valid_records if r[1]]
    successful_runs.sort(key=lambda x: x[2], reverse=True)

    # 4. Report result
    if len(successful_runs) < 2:
        return {
            "median_latency": 0,
            "failed_run_visible": True,
            "median_latency_display": "No data (less than 2 valid runs)",
            "median_latency_display_display": "No data (less than 2 valid runs)"
        }
    else:
        return {
            "median_latency": successful_runs[0][2],
            "failed_run_visible": False,
            "median_latency_display": f"{successful_runs[0][2]:.2f} tokens/sec",
            "median_latency_display_display": f"{successful_runs[0][2]:.2f} tokens/sec"
        }
```
**Reporting if fewer than two runs succeed:**
If fewer than two runs succeed, the result is not a "median". It is a **null result** or **no data**. The metric is undefined, and the code does not produce a numeric median. The user must explicitly state that the median cannot be computed due to insufficient data.

