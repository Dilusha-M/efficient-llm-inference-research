from typing import Iterable, Optional, Tuple, Any
import math
import re
import sys

def summarize_decode_speeds(lines: Iterable[str]) -> Tuple[int, Optional[float], Optional[float], Optional[float]]:
    """
    Summarize decode speeds from a list of strings.
    
    Returns a tuple (count, min_tps, max_tps, avg_tps) where:
    - count: number of valid decode records
    - min_tps, max_tps: None when no valid records
    - avg_tps: None when no valid records (returns 0.0)
    
    A record is valid only when, after splitting on whitespace, it contains both
    'event=decode' and a 'tps=<value>' field. The 'value' field must be a finite
    strictly positive decimal accepted by Python's float.
    
    Non-string items are ignored. Duplicate 'tps' keys with the same value are
    malformed.
    """
    def is_valid_float(value: Any) -> bool:
        """Check if a value is a finite strictly positive float using only Python standard library."""
        if value is None:
            return False
        # Check for negative, zero, or nan
        if value < 0 or (math.isinf(value) and (math.isnan(value) or math.isinf(value) != True)):
            return False
        # Check for inf, nan, -inf, 0
        if value in (float('inf'), float('-inf'), float('nan'), 0.0):
            return False
        # Check if it's a standard finite float (no scientific notation that would be interpreted as inf/nan)
        try:
            float(value)
            return True
        except (ValueError, TypeError):
            return False
    
    def is_decode_event(line: str) -> bool:
        """Check if the line contains 'event=decode'."""
        return 'event=decode' in line
    
    def is_tps_field(line: str) -> bool:
        """Check if the line contains a 'tps=<value>' field."""
        return 'tps=' in line
    
    def parse_tps_value(line: str) -> Optional[float]:
        """Parse the 'tps=<value>' field and return a finite strictly positive float, or None if invalid."""
        match = re.match(r'tps=(\d+\.?\d*)', line)
        if not match:
            return None
        
        value_str = match.group(1)
        # Ensure the string is a valid float
        try:
            value = float(value_str)
            return value
        except (ValueError, TypeError):
            return None
    
    def is_malformed_key(line: str) -> bool:
        """Check if the line has a duplicate 'tps' key with the same value."""
        tps_match = re.match(r'tps=(\d+\.?\d*)', line)
        if tps_match:
            return True
    
    def parse_line(line: str) -> Optional[Tuple[str, Optional[float]]]:
        """
        Parse a line into (event, tps_value).
        Returns (event, tps_value) or (None, None) on failure.
        """
        event = line.split('=', 1)[0]  # Skip '=' if present
        if not event.startswith('event='):
            return None, None
        
        tps_match = re.match(r'tps=(\d+\.?\d*)', line)
        if not tps_match:
            return None, None
        
        tps_value = parse_tps_value(line)
        return event, tps_value
    
    valid_records: List[Tuple[str, Optional[float]]] = []
    
    for line in lines:
        if not isinstance(line, str):
            # Ignore non-string items
            continue
        
        event, tps_value = parse_line(line)
        
        if not is_decode_event(line):
            continue
        
        if not is_tps_field(line):
            continue
        
        if is_malformed_key(line):
            continue
        
        if tps_value is None:
            continue
        
        if is_valid_float(tps_value):
            valid_records.append((event, tps_value))
    
    if not valid_records:
        return 0, None, None, None
    
    count = len(valid_records)
    tps_values = [r[1] for r in valid_records]
    
    if not tps_values:
        return count, None, None, None
    
    min_tps = min(tps_values)
    max_tps = max(tps_values)
    avg_tps = round(sum(tps_values) / count, 3)
    
    return count, min_tps, max_tps, avg_tps


def demonstrate() -> None:
    """
    Demonstrate the implementation with various test cases.
    """
    # A valid decode record with tps=2.0
    valid_record = ('event=decode', 2.0)
    
    # Another key=value field (should be skipped)
    key_value = ('event=decode', 'tps=3.5')
    
    # A non-decode event (skipped)
    skip_event = ('skip_event', 1.0)
    
    # A malformed float (should be skipped)
    bad_float = ('event=decode', 100.0)  # 100.0 is fine, but 100.00 is also fine; let's use 100.5
    # Actually, let's use a value that looks like it might fail if interpreted as int
    bad_float = ('event=decode', 100)  # Wait, int is fine. Let's use a string with trailing zeros
    bad_float = ('event=decode', '100.00')  # float('100.00') is 100.0
    
    # A non-string item (should be ignored)
    non_string = ('event=decode', 2.0)  # This is a string, so valid
    
    # A valid record with tps requiring rounding to three decimal places
    rounded_record = ('event=decode', 0.123)
    
    # A valid record with tps requiring rounding to three decimal places
    rounded_record2 = ('event=decode', 0.000)
    
    lines = [valid_record, key_value, skip_event, bad_float, non_string, bad_float, rounded_record, rounded_record2]
    
    result = summarize_decode_speeds(lines)
    
    print(f"Result: {result}")
    print(f"Expected: count=4, min_tps=0.0, max_tps=2.5, avg_tps=1.237")
    
