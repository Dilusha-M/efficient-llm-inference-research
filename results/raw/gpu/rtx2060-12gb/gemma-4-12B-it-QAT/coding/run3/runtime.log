import math
from typing import Iterable, Dict, Optional, Union

def summarize_decode_speeds(lines: Iterable[Union[str, any]]) -> Dict[str, Optional[Union[float, int]]]:
    """
    Summarizes decode throughput (tps) from a stream of log records.
    
    Complexity:
    - Time: O(N) where N is total characters in the input stream.
    - Space: O(1) as we only store running aggregates and a small set of keys 
      per line.
    """
    count = 0
    min_tps = float('inf')
    max_tps = float('-inf')
    sum_tps = 0.0

    for line in lines:
        if not isinstance(line, str):
            continue
        
        # Tokenize by whitespace
        tokens = line.split()
        data: Dict[str, str] = {}
        
        # Parse key=value pairs
        for token in tokens:
            if '=' not in token:
                continue
            key, val = token.split('=', 1)
            
            # Handle duplicate keys: If key exists, the record is malformed
            if key in data:
                break
            data[key] = val
        else:
            # Executed only if the loop didn't 'break' (no duplicate keys)
            # Check for event=decode and tps=<value>
            if data.get("event") == "decode" and "tps" in data:
                try:
                    tps_raw = data["tps"]
                    tps_val = float(tps_raw)
                    
                    # Validate: finite, strictly positive, not NaN
                    if math.isfinite(tps_val) and tps_val > 0:
                        count += 1
                        if tps_val < min_tps:
                            min_tps = tps_val
                        if tps_val > max_tps:
                            max_tps = tps_val
                        sum_tps += tps_val
                except ValueError:
                    # Handles non-numeric strings like "abc"
                    pass

    # Finalize results
    if count == 0:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }

    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": round(sum_tps / count, 3)
    }

if __name__ == "__main__":
    demo_data = [
        "event=decode tps=50.5 key=test",             # Valid 1
        "event=decode tps=100.25",                     # Valid 2
        "event=prefill tps=20.0",                      # Wrong event
        "event=decode tps=not_a_float",                # Malformed float
        "event=decode tps=nan",                        # NaN
        "event=decode tps=10 tps=20",                  # Duplicate key (malformed)
        12345,                                           # Non-string item
        "event=decode tps=-5.0",                       # Negative value
        "event=decode tps=0.0",                        # Zero value
        "event=decode tps=33.333333",                  # Rounding test
    ]

    # Expected Summary:
    # Valid records: 50.5, 100.25, 33.333333
    # Count: 3
    # Min: 33.333333
    # Max: 100.25
    # Avg: (50.5 + 100.25 + 33.333333) / 3 = 184.083333 / 3 = 61.361111... -> 61.361
    
    result = summarize_decode_speeds(demo_data)
    print(result)

    # Assertions
    # 1. Ensure NaN or Inf are not counted (common error: float("nan") > 0 is False, but it's still a float)
    assert result["count"] == 3, f"Expected 3 records, got {result['count']}"
    # 2. Ensure rounding is correct to 3 decimal places
    assert result["avg_tps"] == 61.361, f"Expected 61.361, got {result['avg_tps']}"
```

### Technical Explanations

**Why naive substring matching is insufficient:**
1.  **Contextual Integrity:** Using `if "event=decode" in line` would incorrectly validate a line like `event=prefill, note=event=decode, tps=50`. A proper parser ensures `event` is a top-level key.
2.  **Duplicate Keys:** Substring matching cannot easily detect if a key appears twice. The requirements state that a duplicate `tps` key makes the record malformed. A parser using a dictionary (or a set of seen keys) handles this naturally.
3.  **Partial Matches:** Substring matching might catch `tps_total=50` as a valid `tps` field. Tokenizing and splitting on `=` ensures we only capture the exact key requested.

**Empty-result policy:**
The function returns `None` for `min_tps`, `max_tps`, and `avg_tps` when `count == 0`. This is standard practice in production data engineering to distinguish between a "zero" value (which is a valid measurement) and the "absence of data" (which is a state of the stream). Returning `0.0` for an empty list would lead to incorrect downstream calculations.

