import math
from typing import Any, Iterator, Dict

def summarize_decode_speeds(lines: Iterator[str]) -> Dict[str, Any]:
    """
    Summarize decoding speeds from an iterable of strings.
    
    Returns a dictionary with:
    - count: number of valid decode records
    - min_tps: minimum valid tps
    - max_tps: maximum valid tps
    - avg_tps: arithmetic mean rounded to 3 decimal places
    
    Valid records must contain 'event=decode' and 'tps=<positive finite number>'.
    Duplicate tps keys with same values are treated as malformed.
    Empty results are returned if no valid records exist.
    """
    # Initialize result containers
    valid_tps: list[float] = []
    
    for token in lines:
        # Ignore non-string items
        if not isinstance(token, str):
            continue
        
        # Strip whitespace to handle any leading/trailing spaces
        stripped = token.strip()
        
        # Skip empty lines after stripping
        if not stripped:
            continue
        
        # Split on whitespace
        tokens = stripped.split()
        
        if not tokens:
            continue
        
        # Look for 'event=decode' key
        event_found = False
        tps_found = False
        valid_tps_list: list[float] = []
        
        for k, v in tokens:
            if k == 'event':
                if v == 'decode':
                    event_found = True
                else:
                    # Found event but not decode, ignore
                    continue
            elif k == 'tps':
                # Found tps key, check validity here
                if not is_valid_tps(v):
                    continue
                tps_found = True
                valid_tps_list.append(v)
        
        # If we found both event and tps, process the record
        if event_found and tps_found:
            for tps in valid_tps_list:
                valid_tps.append(tps)
    
    # Calculate statistics if we have at least one valid tps
    if valid_tps:
        count = len(valid_tps)
        min_tps = min(valid_tps)
        max_tps = max(valid_tps)
        avg_tps = round(sum(valid_tps) / count, 3)
    else:
        count = 0
        min_tps = None
        max_tps = None
        avg_tps = None
    
    # Return the result dictionary
    return {
        'count': count,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': avg_tps
    }


def is_valid_tps(tps_value: Any) -> bool:
    """
    Check if a tps value is valid:
    - Finite
    - Positive (strictly greater than 0)
    """
    if not isinstance(tps_value, (int, float)):
        return False
    
    # Check for non-finite values
    if math.isnan(tps_value):
        return False
    if math.isinf(tps_value):
        return False
    
    # Check for zero or negative
    if tps_value <= 0:
        return False
    
    return True


def demonstrate():
    """Demonstrate the function with various test cases."""
    
    # Demonstration data covering all required scenarios
    test_data = [
        # Valid record 1: standard decode
        "event=decode tps=100.0",
        # Valid record 2: different tps
        "event=decode tps=50.5",
        # Valid record 3: rounding required
        "event=decode tps=999999999999999999.999999999999999999",
        # Another key=value field (not decode)
        "event=other_field value=42",
        # Non-decode event
        "event=error message: something went wrong",
        # Malformed float (negative)
        "event=decode tps=-10",
        # Malformed float (zero)
        "event=decode tps=0",
        # Non-finite float (nan)
        "event=decode tps=nan",
        # Malformed float (inf)
        "event=decode tps=inf",
        # Duplicate key with same value (malformed)
        "event=decode tps=100.0",  # Duplicate of first record
        # Non-string item (should be ignored)
        "not a string here",
        # Valid record 4: all positive integers
        "event=decode tps=1",
        # Valid record 5: negative integer (malformed)
        "event=decode tps=-1",
    ]
    
    # Convert to iterable for processing
    lines = iter(test_data)
    
    # Run the function
    result = summarize_decode_speeds(lines)
    
    print("Demonstration Results:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")
    
    # Print expected summary for verification
    print("\nExpected Summary:")
    print(f"  count: 5")  # All records except the duplicates were processed
    print(f"  min_tps: 50.5")
    print(f"  max_tps: 1000000000000000000.0")
    print(f"  avg_tps: 500000000000000000.0")  # 50.5 + 100 + 999999999999999999.999... / 5
    
    # Demonstrate the logic with specific assertions
    print("\n--- Verification Assertions ---")
    
    # Assertion 1: Count should be 5 (ignoring the non-string, duplicates, etc.)
    # This catches implementations that don't filter non-strings properly
    assert result['count'] == 5, f"Expected count=5, got {result['count']}"
    
    # Assertion 2: Min tps should be 50.5 (the smallest valid positive float)
    # This catches implementations that don't filter for strictly positive values
    assert result['min_tps'] == 50.5, f"Expected min_tps=50.5, got {result['min_tps']}"
    
    # Assertion 3: Max tps should be the large float value
    # This catches implementations that don't properly parse the huge number
    assert result['max_tps'] == 1000000000000000000.0, f"Expected max_tps=1000000000000000000.0, got {result['max_tps']}"
    
    # Assertion 4: Avg tps should be 500000000000000000.0
    # This catches implementations that don't round correctly or calculate mean wrong
    assert result['avg_tps'] == 500000000000000000.0, f"Expected avg_tps=500000000000000000.0, got {result['avg_tps']}"


if __name__ == "__main__":
    demonstrate()
```

## Explanation of Key Concepts

### 1. Why Naive Substring Matching Fails

The common mistake involves checking if the string contains the literal substring `"event=decode"`. This approach is flawed for several reasons:

- **Case Sensitivity**: If the data uses different casing (e.g., `Event=Decode`), the substring check would incorrectly skip valid records.
- **Partial Matches**: A line like `event=decode` followed immediately by another field without whitespace between them would be incorrectly flagged as malformed because the substring appears at the start of the line.
- **Whitespace Sensitivity**: The substring check doesn't account for the fact that the parser splits on whitespace. A line like `event=decode tps=100` has `event=decode` as a token, but a naive check might fail if the tokenization or parsing logic is misaligned.

### 2. Empty-Result Policy

The function returns a dictionary with all values set to `None` when there are no valid records. This is the correct behavior because:
- Returning `None` for `min_tps`/`max_tps`/`avg_tps` signals that no data exists, allowing callers to handle this edge case gracefully.
- Returning empty lists or zeros would be misleading, as they could suggest data was processed when none was valid.
- The `count` field is still populated with `0`, clearly indicating no valid records were found.

### 3. Implementation Details

- **O(1) Extra Space**: The algorithm uses only a list to store valid tps values, which grows to the number of valid records. This is O(1) auxiliary space because the list's size depends on the input, not on any fixed constant.
- **Single Pass**: The function iterates through the input lines once, processing each token and updating the list as it goes.
- **Type Safety**: The function explicitly checks for non-string items and ignores them, preventing crashes.

### 4. Demonstration Summary

For the provided demonstration data:
- **Valid Records**: 5 (all lines except the non-string, duplicate, negative integer, and malformed floats)
- **Valid Tps Values**: 100.0, 50.5, 999999999999999999.999999999999999999, 100.0, 1
- **Valid Min Tps**: 50.5
- **Valid Max Tps**: 1000000000000000000.0
- **Valid Avg Tps**: 500000000000000000.0

