import sys
import math

def summarize_decode_speeds(lines):
    """
    Reviews production-quality Python for an inference benchmark.
    Implements the function below in Python using only the standard library.
    
    Task:
    Implement `summarize_decode_speeds(lines)` where `lines` is an iterable of strings.
    Return a dictionary with exactly these keys:
    
    * `count`: number of valid decode records
    * `min_tps`: minimum valid tps, or `None` when there are no valid records
    * `max_tps`: maximum valid tps, or `None` when there are no valid records
    * `avg_tps`: arithmetic mean rounded to three decimal places, or `None` when there are no valid records
    
    A record is valid only when, after splitting on whitespace, it contains both `event=decode` 
    and a `tps=<value>` field. `<value>` must be a finite, strictly positive decimal accepted by 
    Python's `float`; surrounding whitespace is already removed by tokenization. 
    Ignore malformed lines, non-decode events, duplicate keys with conflicting values, 
    non-finite values (`nan`, `inf`, `-inf`), zero, and negative values. 
    Treat a duplicate `tps` key with the same value as malformed too. 
    Do not crash if `lines` contains a non-string item; ignore that item.
    """
    
    count = 0
    min_tps = None
    max_tps = None
    total_tps = 0.0
    
    for item in lines:
        # Requirement: Do not crash if `lines` contains a non-string item; ignore that item.
        if not isinstance(item, str):
            continue
            
        # Split on whitespace
        tokens = item.split()
        
        # Requirement: A record is valid only when, after splitting on whitespace, 
        # it contains both `event=decode` and a `tps=<value>` field.
        if len(tokens) < 2:
            continue
        
        # Check for 'event=decode'
        event_found = False
        event_value = None
        for token in tokens:
            if '=' not in token:
                continue
            key, value = token.split('=', 1)
            if key == 'event':
                event_found = True
                event_value = value
        
        if not event_found or event_value != 'decode':
            continue
        
        # Requirement: Ignore malformed lines, non-decode events, duplicate keys with conflicting values.
        # We need to ensure there are no duplicate keys with conflicting values.
        # Since we are doing a one-pass algorithm with O(1) extra space (excluding input),
        # we cannot store all records. However, the requirement says "Treat a duplicate tps key with the same value as malformed too."
        # This implies that if we encounter a second 'tps' key, even if the value is the same, we should ignore the record.
        # But wait, if we don't store the previous tps value, we can't detect duplicates.
        # The requirement says "O(1) extra space". This suggests we should process the line and if we find a duplicate key, we ignore the line.
        # However, we need to track if we've seen 'tps' before in the same line.
        
        # Let's re-read: "Treat a duplicate tps key with the same value as malformed too."
        # This implies that if the line has multiple 'tps' keys, it's malformed.
        # We can track the count of 'tps' keys in the current line.
        
        tps_count = 0
        tps_value = None
        
        for token in tokens:
            if '=' not in token:
                continue
            key, value = token.split('=', 1)
            
            if key == 'tps':
                tps_count += 1
                # If we've seen 'tps' before, it's a duplicate key -> malformed
                if tps_count > 1:
                    break
                # Check if value is a valid float
                try:
                    float_val = float(value)
                except ValueError:
                    continue  # Not a valid float
                
                # Check for finite, strictly positive
                if not math.isfinite(float_val) or float_val <= 0:
                    continue
                
                tps_value = float_val
                # If we have a valid tps_value and we encounter another 'tps', we break (duplicate)
                # But we must finish checking the line to ensure there are no other issues?
                # Actually, if we found a duplicate, the line is malformed.
                # So we should ignore the record.
                # However, we need to check if there are other 'event' or 'tps' keys?
                # The requirement says "duplicate keys with conflicting values".
                # If we have two 'tps' keys, it's a duplicate key.
                # So if tps_count > 1, we break and ignore the record.
                
                if tps_count == 2:
                    break
        
        if tps_count == 1 and tps_value is not None:
            # Valid record
            count += 1
            if min_tps is None or tps_value < min_tps:
                min_tps = tps_value
            if max_tps is None or tps_value > max_tps:
                max_tps = tps_value
            total_tps += tps_value

    if count == 0:
        return {
            'count': 0,
            'min_tps': None,
            'max_tps': None,
            'avg_tps': None
        }
    
    return {
        'count': count,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': round(total_tps / count, 3)
    }

