from collections import defaultdict
import math

def summarize_decode_speeds(lines):
    """
    Analyzes a stream of log lines to summarize decode throughput (TPS).
    
    A line is valid if and only if:
    1. It splits into tokens.
    2. One token is 'event=decode'.
    3. Another token is 'tps=<value>' where <value> is a finite, positive float.
    4. There are no duplicate keys (either 'event' or 'tps') with conflicting or same values.
    
    Returns a dict with 'count', 'min_tps', 'max_tps', 'avg_tps'.
    """
    valid_records = []
    
    # We need to track keys per line to detect duplicates within a single line.
    # Since we process line by line, we can use a set for the current line's keys.
    
    for item in lines:
        # Ignore non-string items
        if not isinstance(item, str):
            continue
            
        tokens = item.split()
        if not tokens:
            continue
            
        event_token = None
        tps_token = None
        seen_keys = set()
        is_malformed = False
        
        for token in tokens:
            if '=' not in token:
                continue
            
            key, _, value = token.partition('=')
            
            # Check for duplicate keys within the same line
            if key in seen_keys:
                is_malformed = True
                break
            seen_keys.add(key)
            
            if key == 'event':
                if event_token is not None:
                    is_malformed = True # Duplicate event key
                event_token = token
            elif key == 'tps':
                if tps_token is not None:
                    is_malformed = True # Duplicate tps key
                tps_token = token
        
        # Validation logic
        if is_malformed:
            continue
            
        # Must have both event and tps
        if event_token is None or tps_token is None:
            continue
            
        if event_token != 'event=decode':
            continue
            
        # Parse tps value
        try:
            tps_val_str = tps_token.split('=', 1)[1]
            tps_val = float(tps_val_str)
        except (ValueError, IndexError):
            continue
            
        # Check for non-finite, zero, negative
        if not math.isfinite(tps_val):
            continue
        if tps_val <= 0:
            continue
            
        valid_records.append(tps_val)
        
    if not valid_records:
        return {
            'count': 0,
            'min_tps': None,
            'max_tps': None,
            'avg_tps': None
        }
        
    min_tps = min(valid_records)
    max_tps = max(valid_records)
    avg_tps = round(sum(valid_records) / len(valid_records), 3)
    
    return {
        'count': len(valid_records),
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': avg_tps
    }


if __name__ == "__main__":
