"""
summarize_decode_speeds - production-quality function for parsing
decode-event tps records from log-like lines.
"""

import math
from typing import Dict, Any, Iterable, Optional


def summarize_decode_speeds(lines: Iterable[str]) -> Dict[str, Any]:
    """
    Parse *lines* for valid decode records and return a summary dict with
    keys ``count``, ``min_tps``, ``max_tps``, ``avg_tps``.

    A line is a *valid decode record* when, after splitting on whitespace,
    it contains **both** ``event=decode`` **and** a single ``tps=<value>``
    field where ``<value>`` is a finite, strictly-positive decimal that
    Python's ``float`` accepts.

    Rules:
    * Skip non-string items.
    * Skip lines that don't contain ``event=decode``.
    * Skip lines with zero or more than one ``tps`` field, or with
      duplicate ``tps`` keys that have **different** values (treated as
      malformed).  A duplicate ``tps`` key with the **same** value is
      also treated as malformed.
    * Skip lines where the ``tps`` value is ``nan``, ``inf``, ``-inf``,
      zero, or negative.

    The algorithm is one-pass with O(1) extra space (excluding the input
    iterable itself).
    """
    count = 0
    min_tps: Optional[float] = None
    max_tps: Optional[float] = None
    total: float = 0.0

    for line in lines:
        # Ignore non-string items silently
        if not isinstance(line, str):
            continue

        # Split on whitespace to get tokens
        tokens = line.split()

        # We need to find event=decode and tps=<value>
        has_event_decode = False
        tps_value: Optional[float] = None
        tps_count = 0
        tps_first_value: Optional[float] = None

        for token in tokens:
            # Check for event=decode
            if token.startswith("event="):
                if token == "event=decode":
                    has_event_decode = True
                # If it's event=something_else, we note it but don't
                # set has_event_decode.  Lines without event=decode are
                # invalid regardless of other fields.

            # Check for tps=<value>
            if token.startswith("tps="):
                tps_count += 1
                raw = token[4:]  # everything after "tps="
                try:
                    val = float(raw)
                except (ValueError, OverflowError):
                    # Malformed float; treat entire line as malformed
                    tps_value = None
                    break

                # Check for finite, strictly positive
                if not math.isfinite(val) or val <= 0:
                    tps_value = None
                    break

                if tps_count == 1:
                    tps_first_value = val
                    tps_value = val
                else:
                    # Duplicate tps key
                    if val != tps_first_value:
                        # Conflicting values -> malformed
                        tps_value = None
                        break
                    else:
                        # Same value duplicate -> also malformed per spec
                        tps_value = None
                        break

        # Line is valid only if we have event=decode and exactly one valid tps
        if not has_event_decode:
            continue

        if tps_value is None:
            continue

        # Valid record
        count += 1
        if min_tps is None or tps_value < min_tps:
            min_tps = tps_value
        if max_tps is None or tps_value > max_tps:
            max_tps = tps_value
        total += tps_value

    if count == 0:
        avg_tps: Optional[float] = None
    else:
        avg_tps = round(total / count, 3)

    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": avg_tps,
    }


if __name__ == "__main__":
    # Demonstration lines covering all required cases:
    # 1. Valid record
    # 2. Another key=value field (irrelevant)
    # 3. Non-decode event
    # 4. Malformed float
    # 5. nan
    # 6. Duplicate key with conflicting values
    # 7. Non-string item
    # 8. Valid record whose tps requires rounding

    demo_lines = [
        # 1. Valid record
        "event=decode tps=123.456 other=value",
        # 2. Valid record with extra key=value fields
        "event=decode tps=789.012 foo=bar baz=qux",
        # 3. Non-decode event (should be ignored)
        "event=encode tps=100.0",
        # 4. Malformed float (should be ignored)
        "event=decode tps=abc",
        # 5. nan (should be ignored)
        "event=decode tps=nan",
        # 6. Duplicate tps key with conflicting values (malformed)
        "event=decode tps=100.0 tps=200.0",
        # 7. Non-string item (should be ignored without crash)
        42,
        # 8. Valid record with tps that requires rounding in avg
        "event=decode tps=333.333",
    ]

    result = summarize_decode_speeds(demo_lines)
    print("Result:", result)

    # Expected summary:
    # Valid records: line 0 (tps=123.456), line 1 (tps=789.012), line 7 (tps=333.333)
    # count = 3
    # min_tps = 123.456
    # max_tps = 789.012
    # avg_tps = round((123.456 + 789.012 + 333.333) / 3, 3) = round(1245.801 / 3, 3) = round(415.267, 3) = 415.267

    expected = {
        "count": 3,
        "min_tps": 123.456,
        "max_tps": 789.012,
        "avg_tps": 415.267,
    }
    print("Expected:", expected)
    print("Match:", result == expected)

    # Two focused assertions that would catch common incorrect implementations

    # Assertion 1: Ensure non-decode events are excluded (common bug: accepting any
    # line with tps= regardless of event type)
    non_decode_lines = ["event=encode tps=999.0", "event=decode tps=100.0"]
    r1 = summarize_decode_speeds(non_decode_lines)
    assert r1["count"] == 1, f"Expected count=1 for mixed events, got {r1['count']}"
    assert r1["min_tps"] == 100.0, f"Expected min_tps=100.0, got {r1['min_tps']}"

    # Assertion 2: Ensure nan/inf values are excluded (common bug: not checking
    # for finiteness)
    bad_tps_lines = ["event=decode tps=inf", "event=decode tps=-inf", "event=decode tps=nan", "event=decode tps=0", "event=decode tps=-1.0"]
    r2 = summarize_decode_speeds(bad_tps_lines)
    assert r2["count"] == 0, f"Expected count=0 for all bad tps values, got {r2['count']}"
    assert r2["min_tps"] is None, f"Expected min_tps=None, got {r2['min_tps']}"
    assert r2["max_tps"] is None, f"Expected max_tps=None, got {r2['max_tps']}"
    assert r2["avg_tps"] is None, f"Expected avg_tps=None, got {r2['avg_tps']}"

    print("\nAll assertions passed.")
