Implement `summarize_decode_speeds(lines)` where `lines` is an iterable of strings. Return a dictionary with exactly these keys:

* `count`: number of valid decode records
* `min_tps`: minimum valid tps, or `None` when there are no valid records
* `max_tps`: maximum valid tps, or `None` when there are no valid records
* `avg_tps`: arithmetic mean  ... (truncated)
This solution implements the required function using a single-pass, O(1) extra space approach, relying on a dictionary to store only the necessary summary statistics as we iterate.

```python
import math
from typing import Iterable, Dict, Any, Tuple

def summarize_decode_speeds(lines: Iterable[Any]) -> Dict[str, Any]:
    """
    Analyzes an iterable of strings (lines) to summarize decode performance statistics.

    A record is valid only if it contains 'event=decode' and 'tps=<positive_finite_float>'.

    Args:
        lines: An iterable of items, expected to be strings.

    Returns:
        A dictionary containing the count, min, max, and average of valid TPS values.
    """
    valid_tps: set[float] = set()
    count = 0

    for line in lines:
        # 1. Handle non-string items
        if not isinstance(line, str):
            continue

        # 2. Split and parse the line into key-value pairs
        parts = line.split()
        
        # Store parsed key-value data for this line to check for duplicates later
        data: Dict[str, str] = {}
        
        for part in parts:
            if '=' in part:
                try:
                    key, value = part.split('=', 1)
                    key = key.strip()
                    value = value.strip()
                    data[key] = value
                except ValueError:
                    # Malformed key=value structure, ignore this part
                    continue

        # 3. Validate the parsed data for a valid decode record
        is_decode = data.get('event') == 'decode'
        tps_str = data.get('tps')

        if is_decode and tps_str is not None:
            try:
                tps_value = float(tps_str)
                
                # Check for validity: strictly positive and finite
                if math.isfinite(tps_value) and tps_value > 0:
                    # Check for duplicate TPS values (as per requirement)
                    if tps_value not in valid_tps:
                        valid_tps.add(tps_value)
                        count += 1
            except ValueError:
                # Malformed float value for tps, ignore this record
                continue

    # 4. Calculate summary statistics
    if not valid_tps:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    
    min_tps = min(valid_tps)
    max_tps = max(valid_tps)
    avg_tps = sum(valid_tps) / len(valid_tps)
    
    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": round(avg_tps, 3)
    }

if __name__ == "__main__":
    # Demonstration lines covering all required scenarios:
    test_lines = [
        "event=decode tps=10.5",        # Valid record 1
        "event=other tps=5.0",          # Non-decode event
        "event=decode tps=20.123",      # Valid record 2 (for avg calculation)
        "event=decode tps=10.5",        # Duplicate TPS value (should be ignored for unique set)
        "event=decode tps=nan",         # Non-finite value (NaN)
        "event=decode tps=-5.0",        # Negative value
        "event=decode tps=0.0",         # Zero value
        "event=decode tps=15.000000000000001", # Valid record for max/rounding test
        "malformed line without tps",   # Malformed line
        "event=decode tps=10.5",        # Duplicate of record 1
        "event=error tps=99.0",         # Non-decode event
        12345,                          # Non-string item
        "event=decode tps=10.5000000000000000" # Another valid record (for averaging)
    ]

    print("--- Running Summary Benchmark ---")
    results = summarize_decode_speeds(test_lines)
    
    print("\n--- Calculated Results ---")
    for key, value in results.items():
        print(f"{key}: {value}")

    # Expected calculation breakdown:
    # Valid unique TPS values collected: {10.5, 20.123, 15.000000000000001}
    # Count: 3
    # Min: 10.5
    # Max: 20.123 (Wait, 15.000...1 is larger) -> Max: 20.123
    # Sum: 10.5 + 20.123 + 15.000000000000001 = 45.623000000000001
    # Avg: 45.623000000000001 / 3 = 15.207666666666667
    # Rounded Avg: 15.208

    print("\n--- Assertions for Verification ---")
    
    # Assertion 1: Check the count and the presence of valid statistics
    assert results["count"] == 3, f"Count mismatch. Expected 3, got {results['count']}"
    assert results["min_tps"] == 10.5, f"Min TPS mismatch. Expected 10.5, got {results['min_tps']}"

    # Assertion 2: Check the rounding of the average
    expected_avg = 15.208
    assert results["avg_tps"] == expected_avg, f"Average TPS mismatch. Expected {expected_avg}, got {results['avg_tps']}"
    
    print("All assertions passed successfully.")
