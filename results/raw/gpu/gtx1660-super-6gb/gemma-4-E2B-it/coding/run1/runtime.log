import math
from typing import Iterable, Dict, Any, Optional

def summarize_decode_speeds(lines: Iterable[Any]) -> Dict[str, Optional[float]]:
    """
    Analyzes an iterable of lines to calculate statistics on valid decode TPS values.

    A record is valid only if it contains 'event=decode' and 'tps=<positive_float>'.

    Args:
        lines: An iterable of strings (or other items).

    Returns:
        A dictionary containing the count, min, max, and average of valid TPS values.
    """
    tps_values = []

    for line in lines:
        if not isinstance(line, str):
            continue

        parts = line.split()
        
        # We need to scan the parts to find the specific key-value pairs
        # Since the format is expected to be key=value, we iterate over parts
        record_data = {}
        is_decode = False
        tps_value = None

        for part in parts:
            if '=' in part:
                key, value_str = part.split('=', 1)
                key = key.strip()
                value = value_str.strip()
                
                if key == 'event':
                    record_data['event'] = value
                elif key == 'tps':
                    try:
                        tps = float(value)
                        record_data['tps'] = tps
                    except ValueError:
                        # Malformed float, ignore this line
                        continue
        
        # Validation step: Check for required fields and valid TPS
        if record_data.get('event') == 'decode' and 'tps' in record_data:
            tps = record_data['tps']
            
            # Check for non-finite, zero, or negative values
            if math.isfinite(tps) and tps > 0:
                # Check for duplicate tps values (handled implicitly by adding to list,
                # but we must ensure we don't process duplicates if the requirement implies
                # only unique *records* matter, which is implicitly true if we just track TPS)
                tps_values.append(tps)

    # Final aggregation
    count = len(tps_values)
    
    if count == 0:
        return {
            'count': 0,
            'min_tps': None,
            'max_tps': None,
            'avg_tps': None
        }
    else:
        min_tps = min(tps_values)
        max_tps = max(tps_values)
        avg_tps = sum(tps_values) / count
        
        return {
            'count': count,
            'min_tps': min_tps,
            'max_tps': max_tps,
            'avg_tps': round(avg_tps, 3)
        }

if __name__ == "__main__":
    # Demonstration lines covering various cases
    test_lines = [
        "event=decode tps=10.5",       # Valid record 1
        "event=other tps=5.0",         # Non-decode event
        "event=decode tps=20.0",       # Valid record 2
        "event=decode tps=10.5",       # Duplicate TPS value (should be ignored if we strictly only count unique TPS, but here we track all valid occurrences)
        "event=decode tps=-5.0",       # Negative TPS (invalid)
        "event=decode tps=nan",        # Non-finite TPS (invalid)
        "event=decode tps=0.0",        # Zero TPS (invalid)
        "event=other tps=1.0",         # Another non-decode event
        "event=decode tps=33.333333",  # Valid record requiring rounding
        12345,                        # Non-string item
        "event=decode tps=15.0",       # Valid record 3
    ]

    results = summarize_decode_speeds(test_lines)
    
    print("--- Benchmark Results ---")
    import json
    print(json.dumps(results, indent=4))
    print("------------------------\n")

    # Expected Analysis:
    # Valid records found: 
    # 1. tps=10.5
    # 2. tps=20.0
    # 3. tps=15.0
    # (The duplicate tps=10.5 is also counted as a separate valid occurrence based on the parsing logic)
    # Total valid TPS values: [10.5, 20.0, 10.5, 15.0]
    # Count: 4
    # Min: 10.5
    # Max: 20.0
    # Sum: 10.5 + 20.0 + 10.5 + 15.0 = 56.0
    # Avg: 56.0 / 4 = 14.0
    
    print("--- Assertions ---")
    
    # Assertion 1: Check the count and the existence of bounds
