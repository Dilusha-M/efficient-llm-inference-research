    # malformed floats, NaN, duplicates, non-strings, and a valid record
    # requiring rounding.
    data = [
        # Valid record with tps=10.0
        "event=decode tps=10.0",
        # Key=value field, no decode event
        "event=compute tps=5.5",
        # Non-decode event
        "event=compute",
        # Malformed float: nan
        "event=decode tps=nan",
        # Malformed float: inf
        "event=decode tps=inf",
        # Malformed float: -inf
        "event=decode tps=-inf",
        # Zero value
        "event=decode tps=0",
        # Negative value
        "event=decode tps=-0.1",
        # Duplicate key with conflicting value (malformed)
        "event=decode tps=10.0",
        "event=compute tps=5.5",
        # Non-string item (ignored)
        "not a string",
        # Valid record requiring rounding
        "event=decode tps=2.000",
    ]
    
    result = summarize_decode_speeds(data)
    
    print("Summary:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")
    
    # Assertions to catch common incorrect implementations
    assert result["count"] == 6, f"Expected count=6, got {result['count']}"
    assert result["min_tps"] == 10.0, f"Expected min_tps=10.0, got {result['min_tps']}"
    assert result["max_tps"] == 10.0, f"Expected max_tps=10.0, got {result['max_tps']}"
    assert math.isclose(result["avg_tps"], 2.0, rel_tol=1e-9) == False, \
