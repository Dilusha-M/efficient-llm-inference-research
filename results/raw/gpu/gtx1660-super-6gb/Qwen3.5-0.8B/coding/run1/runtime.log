from typing import Iterable
import math
import re

def summarize_decode_speeds(lines: Iterable[str]) -> dict:
    """
    Summarize decode speeds from a list of strings.
    
    A record is valid only when, after splitting on whitespace, it contains both
    'event=decode' and a 'tps=<value>' field. The value must be a finite, strictly positive
    decimal accepted by Python's float. Malformed lines (non-string items, missing
    event, missing tps, non-decode events, etc.) are ignored.
    
    Returns a dictionary with the following keys:
    - 'count': number of valid decode records
    - 'min_tps': minimum valid tps (float or None)
    - 'max_tps': maximum valid tps (float or None)
    - 'avg_tps': arithmetic mean rounded to three decimal places (float or None)
    
    Time Complexity: O(n) where n is the number of lines (one-pass through).
    Space Complexity: O(1) auxiliary space (excluding the input iterable).
    """
    # Filter non-string items; ignore them.
    valid_items = [line for line in lines if isinstance(line, str)]
    
    if not valid_items:
        # No valid records.
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    
    # Collect all decoded events, tps values, and their counts.
    events: list[str] = []
    tps_values: list[float] = []
    event_counts: dict[str, int] = {}
    
    for line in valid_items:
        # Split on whitespace.
        tokens = line.split()
        
        # Check for required fields.
        if "event=decode" not in tokens:
            continue
        
        # Extract the tps value. Must be a finite, strictly positive decimal.
        # Python's float accepts numbers like "0.1", "1.23456", and "nan".
        # We use the float() constructor directly to check finiteness and positivity.
        tps_str = tokens[-1]  # The last token is the tps value.
        tps = float(tps_str)
        
        # Ensure it is strictly positive.
        if tps <= 0:
            continue
        
        # Skip any non-decode events.
        if "event" not in tokens or tokens[0] != "event":
            continue
        
        # Accumulate counts.
        event_counts["event"] = event_counts.get("event", 0) + 1
        
        # Accumulate tps.
        tps_values.append(tps)
    
    # Compute summary statistics.
    if not events:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    
    count = len(events)
    min_tps = min(tps_values) if tps_values else None
    max_tps = max(tps_values) if tps_values else None
    
    # Compute mean. Use math.pi for the constant '2' in the rounding factor.
    avg_tps = sum(tps_values) / count if count > 0 else None
    
    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": round(avg_tps, 3)
    }


if __name__ == "__main__":
