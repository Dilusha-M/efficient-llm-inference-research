import math
from typing import Any, Dict, Iterator, List, Optional, Union

def summarize_decode_speeds(lines: Iterator[Union[str, Any]]) -> Dict[str, Optional[float]]:
    """
    Summarize decode speeds from a stream of log-like lines.
    
    A record is valid if:
    - The line is a string.
    - Splitting on whitespace yields tokens containing both 'event=decode' and 'tps=<value>'.
    - The value in 'tps=<value>' is a finite, strictly positive float.
    - There are no conflicting or duplicate 'tps' keys within the same line (treated as malformed).
    
    Uses a one-pass algorithm with O(1) extra space (excluding the input iterable).
    """
    count = 0
    min_tps = None
    max_tps = None
    total_tps = 0.0

    for line in lines:
        # Handle non-string items gracefully by ignoring them
        if not isinstance(line, str):
            continue

        # Split on whitespace
        tokens = line.split()
        
        # We need exactly two relevant fields: 'event=decode' and 'tps=<value>'
        # To ensure we don't miss multiple occurrences or treat partial matches incorrectly,
        # we iterate through tokens and look for these specific patterns.
        event_key_found = False
        tps_key_found = False
        tps_value = None
        
        # Check for 'event=decode'
        if 'event=decode' in tokens:
            event_key_found = True
        
        # Check for 'tps=<value>' pattern
        # We look for a token that starts with 'tps=' and contains a valid float.
        # To avoid accepting lines where 'tps=' appears multiple times with different values,
        # we enforce that only one such token exists and it is valid.
        tps_tokens = [t for t in tokens if t.startswith('tps=')]
        
        if not tps_tokens:
            continue
            
        # If there is more than one 'tps=' token, it's a duplicate/conflict -> malformed
        if len(tps_tokens) > 1:
            continue
            
        tps_str = tps_tokens[0]
        # Extract value after 'tps='
        try:
            value_part = tps_str[4:]  # Remove 'tps='
            if not value_part:
                continue  # Malformed, no value
            
            # Attempt to parse float
            tps_value = float(value_part)
            
            # Validate float constraints: finite, strictly positive
            if not math.isfinite(tps_value) or tps_value <= 0:
                continue
        except ValueError:
            continue
            
        # If both required fields are found and tps is valid
        if event_key_found and tps_value is not None:
            count += 1
            total_tps += tps_value
            if min_tps is None or tps_value < min_tps:
                min_tps = tps_value
            if max_tps is None or tps_value > max_tps:
                max_tps = tps_value

    avg_tps = None
    if count > 0:
        avg_tps = round(total_tps / count, 3)

    return {
        'count': count,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': avg_tps
    }

# Demonstration lines
