import math
from typing import Iterable, Union, Dict

def summarize_decode_speeds(lines: Iterable[str]) -> Dict[str, float]:
    """
    Summarize decode speeds from a list of lines (strings).
    
    A valid record is defined as a line where:
    - After splitting by whitespace, the first token is 'event=decode'.
    - The next token is 'tps=<value>'.
    - The value must be a finite, strictly positive float.
    
    Returns a dict with keys: count, min_tps, max_tps, avg_tps.
    Floating point arithmetic is performed with Python's float precision.
    """
    
    if not isinstance(lines, Iterable):
        raise TypeError("lines must be an iterable")
    
    counts = 0
    tps_values: list[float] = []
    seen_tps = {}  # Maps tps_value -> count of records
    
    for raw_line in lines:
        # Skip non-string items gracefully
        if not isinstance(raw_line, str):
            continue
        
        # Split into tokens
        tokens = raw_line.split()
        if not tokens:
            continue
        
        # Check for event=decode
        first_token = tokens[0]
        if first_token != 'event=decode':
            continue
        
        # Check for tps=<value>
        tps_token = tokens[1]
        if tps_token != 'tps=':
            continue
        
        # Extract the numeric value
        try:
            value = float(tps_token)
        except ValueError:
            continue  # Not a valid float
        
        # Validate constraints:
        # - Strictly positive
        # - Finite (not inf, nan)
        # - Not zero
        if value <= 0 or math.isnan(value) or math.isinf(value):
            continue
        
        # Check for duplicates (same tps value appearing multiple times)
        if value in seen_tps:
            continue
        
        # Record a valid count
        counts += 1
        seen_tps[value] = counts  # Increment the count for this tps value
        
        # Accumulate for averages
        tps_values.append(value)

    # Initialize counters
    if counts == 0:
        return {
            'count': 0,
            'min_tps': None,
            'max_tps': None,
            'avg_tps': None
        }
    
    # Calculate statistics
    min_tps = min(tps_values)
    max_tps = max(tps_values)
    avg_tps = sum(tps_values) / len(tps_values)
    
    return {
        'count': counts,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': avg_tps
    }


# Demonstration
