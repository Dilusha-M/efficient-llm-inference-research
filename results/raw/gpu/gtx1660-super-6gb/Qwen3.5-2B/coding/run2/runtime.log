        "event=decode tps=nan",           # Malformed (nan), ignore
        "event=decode tps=100",           # Duplicate, ignore
        "event=decode tps=100",           # Duplicate, ignore
        "event=decode tps=100.5",         # Valid 2, requires rounding
        "event=decode tps=100",           # Duplicate, ignore
        "event=decode tps=100.5",         # Valid 2, requires rounding
        "event=decode tps=100",           # Duplicate, ignore
    ]
    
    result = summarize_decode_speeds(demo_data)
    
