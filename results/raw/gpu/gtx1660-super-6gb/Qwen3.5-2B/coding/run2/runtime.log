    # 5. Nan
    # 6. Duplicate tps key
    # 7. Non-string item (int)
    # 8. Valid record with rounding requirement (tps=100.5)
    
    demo_data = [
        "event=decode tps=100",           # Valid 1
        "event=metrics tps=50",           # Non-decode, ignore
        "event=other tps=10",             # Non-decode, ignore
