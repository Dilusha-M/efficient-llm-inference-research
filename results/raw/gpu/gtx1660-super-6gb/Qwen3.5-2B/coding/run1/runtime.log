from typing import Iterable, Dict, Any, Union, Optional
import math

def summarize_decode_speeds(lines: Iterable[str]) -> Dict[str, Any]:
    """
    Summarize decode speed records from an iterable of strings.
    
    A record is valid only when:
    - The string contains both 'event=decode' and 'tps=<positive finite number>'
    - The tps value is strictly positive and finite (not nan, inf, -inf, zero, negative)
    - No duplicate tps keys with conflicting values
    
    Returns a dictionary with keys: count, min_tps, max_tps, avg_tps
    All values are rounded to 3 decimal places for avg_tps.
    """
    
    # Initialize state
    valid_tps: list[float] = []
    seen_tps: set[float] = set()
    
    # Iterate over lines, skipping non-strings gracefully
    for item in lines:
        if not isinstance(item, str):
            continue  # Ignore non-string items
        
        # Parse the line: split on whitespace, get tokens
        tokens = item.split()
        
        # Must have at least 2 tokens: "event=decode" and "tps=..."
        if len(tokens) < 2:
            continue
            
        event_token = tokens[0]
        tps_token = tokens[1]
        
        # Parse tps value (must be a string to be parsed correctly)
        try:
            tps_str = tps_token.split('=')[1] if '=' in tps_token else ""
        except (IndexError, AttributeError):
            continue
            
        try:
            tps_value = float(tps_str)
        except ValueError:
            continue
            
        # Validation checks:
        # - Finite: check for inf, -inf, nan
        # - Strictly positive: > 0
        if not math.isfinite(tps_value) or tps_value <= 0:
            continue
            
        # Check for duplicates with conflicting values
        if tps_value in seen_tps:
            continue
            
        # Record valid
        seen_tps.add(tps_value)
        valid_tps.append(tps_value)

    # Compute statistics
    if not valid_tps:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    
    count = len(valid_tps)
    min_tps = min(valid_tps)
    max_tps = max(valid_tps)
    avg_tps = round(sum(valid_tps) / count, 3)
    
    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": avg_tps
    }


def demonstrate_demonstration() -> None:
