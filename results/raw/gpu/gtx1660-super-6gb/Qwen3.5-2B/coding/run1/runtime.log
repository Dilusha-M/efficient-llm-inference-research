        "event=debug",
        # 4. Malformed float (non-finite)
        "event=decode tps=nan",
        # 5. Zero tps (invalid)
        "event=decode tps=0",
        # 6. Negative tps (invalid)
        "event=decode tps=-10",
        # 7. Duplicate tps key with same value
        "event=decode tps=50.0",
        # 8. Another valid record with rounding
        "event=decode tps=150.5",
        # 9. Non-string item (ignored)
        12345,  # Integer in list
        # 10. Another valid record with non-standard float representation
        "event=decode tps=1e2",
        # 11. Another valid record with decimal precision
        "event=decode tps=1.500000001",
        # 12. Empty tps value (invalid)
        "event=decode",
        # 13. Only one token
