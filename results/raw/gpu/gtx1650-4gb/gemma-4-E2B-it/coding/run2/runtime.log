Implement `summarize_decode_speeds(lines)` where `lines` is an iterable of strings. Return a dictionary with exactly these keys:

* `count`: number of valid decode records
* `min_tps`: minimum valid tps, or `None` when there are no valid records
* `max_tps`: maximum valid tps, or `None` when there are no valid records
* `avg_tps`: arithmetic mean  ... (truncated)
This solution implements the required function using a single pass with $O(1)$ extra space, adhering strictly to the requirements.

```python
import math
from typing import Iterable, Dict, Any, Tuple

def summarize_decode_speeds(lines: Iterable[Any]) -> Dict[str, Any]:
    """
    Analyzes an iterable of lines to summarize valid decode performance statistics.

    A record is valid only if it contains 'event=decode' and 'tps=<positive_finite_number>'.

    Args:
        lines: An iterable of strings or other items to be processed.

    Returns:
        A dictionary containing the count, min, max, and average TPS of valid records.
    """
    tps_values = []

    for line in lines:
        # 1. Handle non-string items and ensure line is a string
        if not isinstance(line, str):
            continue
            
        parts = line.split()
        if not parts:
            continue

        # 2. Parse key-value pairs into a dictionary (one-pass state tracking)
        record = {}
        is_decode = False
        tps_value = None

        for part in parts:
            if '=' in part:
                key, value = part.split('=', 1)
                key = key.strip()
                value = value.strip()

                if key == 'event':
                    record['event'] = value
                    if value == 'decode':
                        is_decode = True
                elif key == 'tps':
                    try:
                        tps_float = float(value)
                        # Check for validity: positive and finite
                        if math.isfinite(tps_float) and tps_float > 0:
                            tps_value = tps_float
                        else:
                            # Invalid tps value (zero, negative, NaN, Inf)
                            tps_value = None
                    except ValueError:
                        # Malformed float value
                        tps_value = None
            
            # Note: We ignore other keys and handle duplicates implicitly by only
            # storing the relevant 'tps' if it's valid.

        # 3. Validate the record
        if is_decode and tps_value is not None:
            tps_values.append(tps_value)

    # 4. Calculate summary statistics
    count = len(tps_values)
    
    if count == 0:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    else:
        min_tps = min(tps_values)
        max_tps = max(tps_values)
        total_tps = sum(tps_values)
        avg_tps = round(total_tps / count, 3)

        return {
            "count": count,
            "min_tps": min_tps,
            "max_tps": max_tps,
            "avg_tps": avg_tps
        }

if __name__ == "__main__":
    # Demonstration lines covering various scenarios
    test_lines = [
        "event=decode tps=10.5",            # Valid record
        "event=other tps=5.0",              # Non-decode event
        "event=decode tps=20.123",          # Valid record
        "event=decode tps=10.5",            # Duplicate tps value (should be ignored/handled)
        "event=decode tps=invalid_float",   # Malformed float
        "event=decode tps=nan",             # Non-finite value
        "event=decode tps=-5.0",            # Negative value
        "event=decode tps=33.33333333333333", # Valid record requiring rounding
        12345,                              # Non-string item
        "event=decode tps=5.0"              # Another valid record
    ]

    print("--- Running Benchmark Summary ---")
    results = summarize_decode_speeds(test_lines)
    
    print("\n--- Results ---")
    for key, value in results.items():
        print(f"{key}: {value}")

    # Expected calculation verification:
    # Valid TPS values: [10.5, 20.123, 33.33333333333333, 5.0]
    # Count: 4
    # Sum: 10.5 + 20.123 + 33.33333333333333 + 5.0 = 68.95633333333333
    # Avg: 68.95633333333333 / 4 = 17.239083333333332
    # Rounded Avg: 17.239

    # Assertions to catch common implementation errors
    assert results["count"] == 4, "Assertion 1 Failed: Incorrect record count."
    assert results["min_tps"] == 5.0, "Assertion 2 Failed: Minimum TPS calculation error."
    
    print("\n--- Verification ---")
    print("All assertions passed successfully.")
