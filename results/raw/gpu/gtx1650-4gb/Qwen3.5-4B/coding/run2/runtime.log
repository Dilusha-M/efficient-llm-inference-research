from __future__ import annotations

import math
from typing import Any, Iterable

def summarize_decode_speeds(lines: Iterable[Any]) -> dict[str, Any]:
    """
    Summarize decode speeds from a stream of key=value lines.
    
    A record is valid only when:
    - It contains the token "event=decode"
    - It contains a token "tps=<value>" where <value> is a finite, strictly positive float.
    - There are no duplicate keys with conflicting values.
    - Duplicate keys with the same value are treated as malformed.
    
    Returns a dictionary with keys: count, min_tps, max_tps, avg_tps.
    
    Constraints:
    - One-pass algorithm.
    - O(1) extra space (excluding the input iterable).
    - Ignores non-string items in the input.
    """
    
    # State variables for one-pass processing
    has_valid = False
    min_tps = None
    max_tps = None
    total_tps = 0.0
    count = 0
    
    # Using a single key to track the current valid tps value for the line.
    # If we encounter a duplicate key, we treat the line as malformed.
    # Since we process line by line, we only need to track the current line's state.
    # However, the problem implies a stream where one line might have duplicate keys?
    # "Ignore ... duplicate keys with conflicting values" and "Treat a duplicate tps key with the same value as malformed too."
    # This implies we must detect duplicates within a single line.
    # Since we are doing one-pass and O(1) space (excluding the line string itself),
    # we can maintain a small set of keys seen in the current line.
    # But wait, "O(1) extra space" usually means independent of line length or number of fields?
    # If the line can have arbitrarily many keys, a set is O(n) space.
    # Let's re-read carefully: "Treat a duplicate tps key with the same value as malformed too."
    # If the line is "event=decode tps=10 event=decode tps=10", this is malformed.
    # To do this strictly with O(1) space relative to line length is impossible if we need to count duplicates.
    # However, typically "O(1) space" in streaming contexts allows space proportional to the state (number of active records), not the line length.
    # If the line has O(L) fields, checking for duplicates in a set is O(L).
    # Is there a way to do this without storing all keys?
    # Perhaps the constraint implies we don't need to store the whole line's state, 
    # but since we can't revisit the line, we must track what we've seen.
    # If the line is maliciously long with many keys, a set is O(L).
    # However, given the specific requirement "Treat a duplicate tps key... as malformed", 
    # and the context of "inference benchmark", lines are likely short.
    # But to be pedantically correct about O(1) space excluding the input iterable:
    # We can only track a few things if we assume the number of unique keys in a valid line is small?
    # Or perhaps the "O(1)" refers to not storing the history of all lines (the output), 
    # but the state for the current line must be O(1) words.
    # If a line has N keys, we need O(N) space to detect duplicates.
    # Let's assume the standard interpretation for such benchmarks: 
    # We process tokens. If we see a key we've already seen in this line, it's a duplicate.
    # To satisfy O(1) space strictly, we might assume the line format is fixed (e.g., event, tps) or we accept that 
    # for a generic line, detecting duplicates requires storing seen keys.
    # However, the prompt says "O(1) extra space (excluding the input iterable)". 
    # This is a strong constraint. It suggests we might not need to store the line's keys.
    # Could the logic be: We only care about `event=decode` and `tps`.
    # If we see `event=decode` again, is it a conflict? "Duplicate keys with conflicting values".
    # If we see `tps` again, is it a conflict? "Duplicate keys ... malformed".
    # If we assume the input lines are well-formed in structure (two keys), then duplicate detection is trivial.
    # But the spec says "Ignore malformed lines".
    # Let's assume the safest O(1) approach: We only track the current `event` and `tps` values for the current line.
    # If we encounter a second `event` or `tps` key in the same line, we mark the line as invalid.
    # To do this, we need to remember if we saw `event` or `tps` before in the current line.
    # Variables `seen_event` and `seen_tps` are O(1).
    # If we see `event` again -> malformed.
    # If we see `tps` again -> malformed.
    # This satisfies the duplicate constraint for the specific keys of interest without storing all keys.
    
    # Flags for current line
    seen_event = False
    seen_tps = False
    
    for line in lines:
        # Handle non-string items
        if not isinstance(line, str):
            continue
        
        # Split into tokens
        try:
            tokens = line.split()
        except Exception:
            # In case split fails, treat as invalid
            continue
        
        # Initialize line state for this iteration
        seen_event = False
        seen_tps = False
        
        # Parse tokens
        valid_line = True
        
        for token in tokens:
            if token.startswith('event='):
                # Check for duplicate event key
                if seen_event:
                    valid_line = False
                    break
                seen_event = True
                
                # Extract value
                event_val = token[6:]  # slice after '='
                
                # Basic check: event_val should be "decode"
                # The spec says "contains both event=decode". It implies the value must be "decode".
                # If it's "event=decode_something", is it valid? 
                # "contains event=decode" usually implies the value is exactly "decode".
                # Let's assume strict equality.
                if event_val != "decode":
                    valid_line = False
                    break
            
            elif token.startswith('tps='):
                # Check for duplicate tps key
                if seen_tps:
                    valid_line = False
                    break
                seen_tps = True
                
                # Extract value
                tps_str = token[4:]  # slice after '='
                
                # Parse float
                try:
                    tps_val = float(tps_str)
                except ValueError:
                    valid_line = False
                    break
                
                # Check constraints on float
                if not math.isfinite(tps_val):
                    # nan, inf, -inf
                    valid_line = False
                    break
                
                if tps_val <= 0:
                    # zero or negative
                    valid_line = False
                    break
            
            # Ignore other keys (e.g., "latency=100")
            # Unless they are duplicates of event or tps? 
            # The spec says "duplicate keys". If there is a key "tps2", it's not a duplicate of "tps".
            # But if the line is "event=decode tps=10 tps=20", that is a duplicate 'tps' key.
            # Our logic above handles seeing 'tps' twice.
        
        if valid_line:
            count += 1
            if min_tps is None or tps_val < min_tps:
                min_tps = tps_val
            if max_tps is None or tps_val > max_tps:
                max_tps = tps_val
            total_tps += tps_val

