            "max_tps": None,
            "avg_tps": None
        }
    
    avg_tps = round(total_tps / count, 3)
    
    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": avg_tps
    }

