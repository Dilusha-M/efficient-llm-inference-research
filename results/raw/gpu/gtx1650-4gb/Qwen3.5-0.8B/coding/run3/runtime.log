```python
from typing import Optional

def summarize_decode_speeds(lines: Iterable[str]) -> dict[str, Optional[float]]:
    """
    Compute summary statistics for decode records from a stream of string lines.
    
    A record is valid if:
      - It is a string
      - It contains exactly two tokens: "event=decode" and "tps=<value>"
      - The token for tps is a finite, strictly positive float
      - The tps key appears exactly once (no duplicate)
    
    Parameters
    ----------
    lines : Iterable[str]
        Input iterable of string lines.
        
    Returns
    -------
    dict
        Dictionary with keys: count, min_tps, max_tps, avg_tps.
        All values are None when no valid records are found.
    """
    count = 0
    tps_vals: list[float] = []
    # Use a single-pass, O(1) space approach:
    # Track current tps value and count occurrences.
    current_tps = None
    count_tps = 0
    seen_tps: set[float] = set()
    
    for line in lines:
        # Ignore non-string items
        if not isinstance(line, str):
            continue
        
        # Split by whitespace and tokenize
        tokens = line.split()
        
        # Check for required event and tps key
        if tokens[0] != "event" or tokens[1] != "decode":
            continue
        
        # Extract tps value
        if len(tokens) >= 3:
            tps_value = tokens[2]
            
            # Validate tps value: finite, strictly positive float
            if not isinstance(tps_value, (int, float)) or float(tps_value) <= 0:
                continue
            
            # Validate uniqueness: ensure no duplicate tps key
            if tps_value in seen_tps:
                continue
            seen_tps.add(tps_value)
            count_tps += 1
        else:
            # No tps token found; skip this line
            continue
        
        # Record a valid decode
        count += 1
        tps_vals.append(float(tps_value))
    
    # Compute statistics
    if count == 0:
        return {
            "count": None,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    
    return {
        "count": count,
        "min_tps": min(tps_vals),
        "max_tps": max(tps_vals),
        "avg_tps": round(sum(tps_vals) / count, 3)
    }
```

