    ]
    res = summarize_decode_speeds(lines)
    print("count:", res["count"])
    print("min_tps:", res["min_tps"])
    print("max_tps:", res["max_tps"])
    print("avg_tps:", res["avg_tps"])
    
    # 2. Key=value field (no decode)
    lines = [
        "key=value",
        "key=value",
        "key=value",
    ]
    res = summarize_decode_speeds(lines)
    print("\nAfter key=value lines: count =", res["count"])
    
    # 3. Non-decode event
    lines = [
        "event=login\nuser=john",
        "event=logout\nuser=jane",
    ]
    res = summarize_decode_speeds(lines)
    print("\nAfter login/logout lines: count =", res["count"])
    
    # 4. Malformed float
    lines = [
        "event=decode\ntps=abc",
        "event=decode\ntps=  35.0",
    ]
    res = summarize_decode_speeds(lines)
    print("\nAfter malformed float lines: count =", res["count"])
    
    # 5. NaN
    lines = [
        "event=decode\ntps=nan",
        "event=decode\ntps=inf",
        "event=decode\ntps=-inf",
    ]
    res = summarize_decode_speeds(lines)
    print("\nAfter NaN/inf lines: count =", res["count"])
    
    # 6. Duplicate tps key (should be ignored)
    lines = [
        "event=decode\ntps=35.0",
        "event=decode\ntps=35.0",
        "event=decode\ntps=35.0",
        "event=decode\ntps=35.0",
    ]
    res = summarize_decode_speeds(lines)
    print("\nAfter duplicate tps lines: count =", res["count"])
    
    # 7. Non-string item
    lines = [
        123,
        "event=decode\ntps=35.0",
        "event=decode\ntps=35.0",
    ]
    res = summarize_decode_speeds(lines)
    print("\nAfter non-string lines: count =", res["count"])
    
    # 8. Valid record with tps requiring rounding to 3 decimals
    lines = [
        "event=decode\ntps=35.0",
        "event=decode\ntps=35.0",
        "event=decode\ntps=35.0",
    ]
    res = summarize_decode_speeds(lines)
    print("\nAfter rounding lines: count =", res["count"])
    print("avg_tps:", res["avg_tps"])
