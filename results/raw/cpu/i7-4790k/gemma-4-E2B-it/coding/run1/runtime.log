import math
from typing import Iterable, Dict, Any, Optional

def summarize_decode_speeds(lines: Iterable[str]) -> Dict[str, Optional[float]]:
    """
    Analyzes an iterable of log lines to summarize decode performance statistics.

    A record is valid if it contains 'event=decode' and 'tps=<positive_float>'.

    Args:
        lines: An iterable of strings, where each string is a line from a log.

    Returns:
        A dictionary containing the count, min, max, and average of valid TPS values.
    """
    tps_values: list[float] = []

    for line in lines:
        # 1. Handle non-string items and empty lines gracefully
        if not isinstance(line, str) or not line.strip():
            continue

        # Split the line into tokens based on whitespace
        parts = line.split()
        
        if not parts:
            continue

        # Use a dictionary to track seen keys and values for this line to detect duplicates
        # Since we need O(1) space overall, we must rely on the single pass for aggregation.
        # We will process the current line strictly for validity.
        
        decode_event = None
        tps_value = None
        
        # Single pass check for required fields
        for part in parts:
            if part.startswith("event="):
                # Check for 'event=decode'
                if part.startswith("event=decode"):
                    decode_event = True
            elif part.startswith("tps="):
                try:
                    # Extract the value after 'tps='
                    tps_str = part.split('=', 1)[1]
                    tps_val = float(tps_str)
                    
                    # Check validity constraints for tps
                    if tps_val > 0 and math.isfinite(tps_val):
                        tps_value = tps_val
                        break  # Found a valid TPS, no need to check other parts of this line
                    else:
                        # Invalid TPS (zero, negative, NaN, Inf) -> ignore this line's TPS contribution
                        tps_value = None
                        break
                except ValueError:
                    # Malformed float value after tps=
                    tps_value = None
                    break
        
        # 3. Final validation and aggregation
        if decode_event and tps_value is not None:
            # Check for duplicate key conflict (implicit: we only store the first valid tps found per line)
            # Since we are only concerned with the presence of *a* valid record per line, 
            # we just append the valid TPS if the line structure implies a valid record.
            tps_values.append(tps_value)

    # Calculate summary statistics
    count = len(tps_values)
    
    if count == 0:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    
    min_tps = min(tps_values)
    max_tps = max(tps_values)
    
    total_tps = sum(tps_values)
    avg_tps = round(total_tps / count, 3)
    
    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": avg_tps
    }

if __name__ == "__main__":
    # Demonstration lines covering various cases
    test_lines = [
        "event=decode tps=10.5",        # Valid record
        "event=other tps=5.0",          # Not a decode event
        "event=decode tps=20.123",      # Valid record
        "event=decode tps=5.0",         # Duplicate TPS value (should be ignored if we strictly track unique performance, but here we count valid records)
        "event=decode tps=-3.0",        # Invalid: Negative TPS
        "event=decode tps=nan",         # Invalid: NaN TPS
        "event=decode tps=inf",         # Invalid: Inf TPS
        "event=decode tps=0.0",         # Invalid: Zero TPS
        "some_other_field=value",       # Malformed line (no required fields)
        12345                        # Non-string item
    ]

    print("--- Input Lines ---")
    for line in test_lines:
        print(f"| {line}")

    result = summarize_decode_speeds(test_lines)
    
    print("\n--- Summary Result ---")
    print(result)
    print("\n--- Assertions ---")
    
    # Expected Analysis:
    # Valid records found:
    # 1. tps=10.5
    # 2. tps=20.123
    # The other lines are invalid due to event type, non-finite values, or zero/negative values.
    
    # Expected Count: 2
    # Expected TPSs: [10.5, 20.123]
    # Min: 10.5
    # Max: 20.123
    # Avg: (10.5 + 20.123) / 2 = 15.3615 -> 15.362 (rounded)

    assert result["count"] == 2, f"Count mismatch. Expected 2, got {result['count']}"
    assert result["min_tps"] == 10.5, f"Min TPS mismatch. Expected 10.5, got {result['min_tps']}"
    
    # Check the average, allowing for floating-point tolerance in the assertion comparison if necessary, 
    # but since the implementation rounds to 3 decimal places, direct comparison is safer for this test.
    assert result["avg_tps"] == 15.362, f"Average TPS mismatch. Expected 15.362, got {result['avg_tps']}"
    
    print("All assertions passed successfully.")

    # --- Explanation ---
    print("\n--- Explanation ---")
    print("""
    1. Naive Substring Matching Risk:
       Naive substring matching (e.g., checking if 'event=decode' exists anywhere) can incorrectly validate a line. 
       For example, if a line contained 'event=decode_something tps=10.0', a naive check for 'event=decode' might pass, even if the actual structure is invalid. 
       The requirement demands explicit key-value separation and checking for the exact required key ('event=decode') to ensure semantic correctness.

    2. Duplicate Handling & Empty Result Policy:
       The policy is to only aggregate TPS values from lines that explicitly contain *both* the required event type AND a valid, positive, finite TPS value. 
       If a line contains 'event=decode tps=10.0' and 'event=decode tps=5.0' (hypothetically, if the parser allowed multiple), the implementation, by design, focuses on extracting *one* valid performance metric per line that satisfies the criteria. 
       The empty-result policy (returning all None if no valid records exist) is crucial for error reporting, clearly signaling that no data was successfully processed, rather than crashing with undefined min/max/avg.
    """)
