from typing import Iterable, Union

def summarize_decode_speeds(lines: Iterable[str]) -> dict[str, Union[int, None]]:
    """
    Summarize decode speeds for a list of strings.

    A record is valid only when, after splitting on whitespace, it contains:
        - 'event=decode'
        - a key 'tps' with a finite, strictly positive decimal value.

    Returns a dictionary with keys:
        count: number of valid decode records
        min_tps: minimum valid tps, or None if no valid records
        max_tps: maximum valid tps, or None if no valid records
        avg_tps: arithmetic mean rounded to three decimal places, or None if no valid records

    Algorithm (one-pass, O(1) extra space):
    1. Initialize counters and variables for count, min_tps, max_tps, avg_tps.
    2. Iterate through lines one pass:
       a. Split each line by whitespace.
       b. Check if the line is a string and contains 'event=decode'.
          If not, ignore.
       c. Parse the rest as a key-value pair (using `split('=', 1)`).
          If the resulting list is not a dictionary, ignore.
       d. If the key is 'tps' and the value is finite, strictly positive,
          and matches the required format (allowed numbers only):
          - Extract the numeric value.
          - Update counts, min/max, and average accordingly.
       e. If any field fails the above checks, discard the line.

    Empty-result policy:
    - If no valid records are found, return {
        'count': 0,
        'min_tps': None,
        'max_tps': None,
        'avg_tps': None
    }.
    - The function does not crash on non-string items in lines because
      we first check `if not isinstance(line, str)`.

    Demonstration lines:
    - Valid record with tps=1000
    - Key=value field
    - Non-decode event
    - Malformed float (negative)
    - NaN value
    - Duplicate key with conflicting value
    - Non-string item
    - Valid record requiring rounding
    """

    count = 0
    min_tps = None
    max_tps = None
    avg_tps = None

    for line in lines:
        # 1. Check if line is a string
        if not isinstance(line, str):
            continue

        # 2. Check for 'event=decode'
        if 'event=decode' not in line:
            continue

        # 3. Split by whitespace
        parts = line.split()
        if len(parts) != 2:
            continue  # malformed line

        # 4. Parse key=value pair
        key, value_part = parts[0], parts[1]

        # 5. Check if key is 'tps'
        if key != 'tps':
            continue

        # 6. Check if value_part is a valid finite, strictly positive decimal
        #    Python float accepts: finite, >= 0, and standard decimal representation.
        try:
            v = float(value_part)
        except (ValueError, TypeError):
            continue  # invalid format

        if v <= 0 or not isinstance(v, (int, float)):
            continue  # non-positive or non-numeric

        # 7. Record valid record
        count += 1
        if min_tps is None or v < min_tps:
            min_tps = v
        if max_tps is None or v > max_tps:
            max_tps = v
        if count > 0:
            avg_tps = count / 1.0  # average is just count itself

    return {
        'count': count,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': avg_tps
    }


if __name__ == "__main__":
    examples = [
        "event=decode tps=1000",
        "event=decode tps=500",
        "event=compute",
        "event=decode tps=-100",
        "event=decode nan=100",
        "event=decode tps=100",
        "event=decode tps=100",
        "not a string",
        "event=decode tps=0.0",
        "event=decode tps=100.0",
    ]

    result = summarize_decode_speeds(examples)

    print("Summary:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")

    # Assertions to catch common incorrect implementations
    assert result['count'] == 7, "Should find 7 valid decode records"
    assert result['min_tps'] == 100.0, "Min should be 100.0, not NaN"
    assert result['max_tps'] == 100.0, "Max should be 100.0, not -100"
    assert abs(result['avg_tps'] - 1.0) < 1e-5, "Avg should be 1.0"
    assert result['min_tps'] is not None, "min_tps should not be None"
    assert result['max_tps'] is not None, "max_tps should not be None"
