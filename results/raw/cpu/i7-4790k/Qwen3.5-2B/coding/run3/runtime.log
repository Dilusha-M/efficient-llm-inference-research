```python
from typing import Iterator, Any, Dict, Optional
import math

def summarize_decode_speeds(lines: Iterator[str]) -> Dict[str, Any]:
    """
    Summarize decode speeds from an iterable of strings using a single-pass,
    O(1) extra-space algorithm.

    A valid record must contain:
      - event=decode
      - tps=<value> where <value> is a finite, strictly positive float

    Returns:
      {
        'count': int,
        'min_tps': float | None,
        'max_tps': float | None,
        'avg_tps': float | None
      }
    """

    count = 0
    min_tps = None
    max_tps = None

    # Naive approach: iterate, check event, then check tps.
    # This works but requires iterating until end to find max/min/avg.
    # We can optimize by accumulating stats in a single pass:
    #   - count += 1
    #   - update min/max/avg as we go
    # This is O(1) extra space (excluding input) and one pass.

    def _check_valid_tps(value: Any) -> bool:
        if isinstance(value, (float, int)):
            val = float(value)
            if math.isinf(val) or math.isnan(val):
                return False
            if val <= 0:
                return False
            return True
        return False

    for item in lines:
        # Ignore non-string items
        if not isinstance(item, str):
            continue

        # Strip leading/trailing whitespace (though prompt says it's already removed,
        # being explicit ensures robustness against tokenization artifacts).
        line = item.strip()

        if not line:
            continue

        # Split on whitespace
        parts = line.split()
        if not parts:
            continue

        # Check for required fields
        event_parts = [p for p in parts if p.startswith("event=")]
        tps_parts = [p for p in parts if p.startswith("tps=")]

        if not event_parts or not tps_parts:
            continue

        event = event_parts[0][6:]  # remove "event="
        tps_str = tps_parts[0][4:]  # remove "tps="

        # Normalize tps value
        try:
            tps = float(tps_str)
        except ValueError:
            continue

        if not _check_valid_tps(tps):
            continue

        # Normalize event name to lowercase for comparison (optional safety)
        event_lower = event.lower()
        if event_lower != "decode":
            continue

        # Increment count
        count += 1

        # Track min/max/avg
        if min_tps is None or tps < min_tps:
            min_tps = tps
        if max_tps is None or tps > max_tps:
            max_tps = tps
        if max_tps is None or count > 0:
            # Round to 3 decimal places
            avg_tps = round(sum([float(x) for x in [min_tps, max_tps, tps] if x is not None]), 3)
            # Actually we need the mean of valid tps, not the average of (min, max, tps)
            # Correct logic: mean of all valid tps encountered so far.
            # However, since we update min/max/avg incrementally, we need to track the running mean.
            # Let's restart the logic:
            #   count++
            #   tps_sum += tps
            #   tps_min = min(min_tps, tps)
            #   tps_max = max(max_tps, tps)
            #   tps_avg = tps_sum / count
            # This requires storing tps_sum.
            pass

        # Re-structure the loop for proper incremental stats:
        # We'll just do a simple pass with accumulators.
        # To ensure O(1) space and one pass, we can't use dictionaries.
        # But we can use simple variables.
        # We'll reset the logic slightly inside the loop:
        #   count = 0
        #   min_tps = None
        #   max_tps = None
        #   tps_sum = 0.0
        # This is still O(1) extra space (excluding input iterable).
        # And it's one pass.
        # So we don't need the nested function.

    # Correct incremental implementation:
    count = 0
    min_tps = None
    max_tps = None
    tps_sum = 0.0

    for item in lines:
        if not isinstance(item, str):
            continue
        line = item.strip()
        if not line:
            continue
        parts = line.split()
        if not parts:
            continue

        event_parts = [p for p in parts if p.startswith("event=")]
        tps_parts = [p for p in parts if p.startswith("tps=")]

        if not event_parts or not tps_parts:
            continue

        event = event_parts[0][6:]  # remove "event="
        tps_str = tps_parts[0][4:]  # remove "tps="

        try:
            tps = float(tps_str)
        except ValueError:
            continue

        if not _check_valid_tps(tps):
            continue

        event_lower = event.lower()
        if event_lower != "decode":
            continue

        count += 1
        tps_sum += tps
        if min_tps is None or tps < min_tps:
            min_tps = tps
        if max_tps is None or tps > max_tps:
            max_tps = tps

    # Compute average
    avg_tps = tps_sum / count if count > 0 else None

    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": avg_tps
    }


def main():
