import math
from typing import Iterable, Dict, Any, Tuple

def summarize_decode_speeds(lines: Iterable[Any]) -> Dict[str, Any]:
    """
    Analyzes an iterable of lines to summarize decode performance statistics.

    A record is valid only if it contains 'event=decode' and 'tps=<positive_float>'.

    Args:
        lines: An iterable of strings (or other types).

    Returns:
        A dictionary containing the count, min, max, and average of valid TPS values.
    """
    tps_values = []
    
    for line in lines:
        # 1. Ignore non-string items
        if not isinstance(line, str):
            continue
            
        # 2. Split on whitespace and process tokens
        parts = line.split()
        
        # Check for required keys
        event_found = False
        tps_value = None
        
        for part in parts:
            if part.startswith("event="):
                # Check for 'event=decode'
                if part == "event=decode":
                    event_found = True
                # Ignore other event keys if they exist, focusing only on 'decode'
            
            elif part.startswith("tps="):
                try:
                    # Extract the value part
                    tps_str = part.split('=', 1)[1]
                    tps = float(tps_str)
                    
                    # Check validity criteria: strictly positive and finite
                    if math.isfinite(tps) and tps > 0:
                        tps_value = tps
                    else:
                        # Ignore zero, negative, or non-finite values
                        tps_value = None
                        
                except ValueError:
                    # Malformed float, ignore this tps field
                    tps_value = None
        
        # 3. Record valid decode records
        if event_found and tps_value is not None:
            tps_values.append(tps_value)

    # 4. Calculate summary statistics
    count = len(tps_values)
    
    if count == 0:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    else:
        min_tps = min(tps_values)
        max_tps = max(tps_values)
        avg_tps = sum(tps_values) / count
        
        return {
            "count": count,
            "min_tps": min_tps,
            "max_tps": max_tps,
            "avg_tps": round(avg_tps, 3)
        }

# --- Demonstration ---
