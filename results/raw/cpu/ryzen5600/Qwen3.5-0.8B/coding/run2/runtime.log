    assert result6['count'] == 1, f"Expected count 1, got {result6['count']}"
    assert result6['min_tps'] == 0.0, f"Expected min 0.0, got {result6['min_tps']}"
    assert result6['max_tps'] == 0.0, f"Expected max 0.0, got {result6['max_tps']}"
