    # Example 7: Negative infinity
    lines7 = [
        "event=decode tps=-inf"
    ]
    result7 = summarize_decode_speeds(lines7)
    print(f"Demo 7: {result7}")
    assert result7['count'] == 1, f"Expected count 1, got {result7['count']}"
    assert result7['min_tps'] == -float('inf'), f"Expected min -inf, got {result7['min_tps']}"
    assert result7['max_tps'] == -float('inf'), f"Expected max -inf, got {result7['max_tps']}"
    assert result7['avg_tps'] == -float('inf'), f"Expected avg -inf, got {result7['avg_tps']}"

    # Example 8: Duplicate tps with different values (should be valid)
    lines8 = [
        "event=decode tps=1000.5"
        "tps=2000.0"  # Different value, not duplicate
    ]
    result8 = summarize_decode_speeds(lines8)
    print(f"Demo 8: {result8}")
    assert result8['count'] == 2, f"Expected count 2, got {result8['count']}"
    assert result8['min_tps'] == 1000.5, f"Expected min 1000.5, got {result8['min_tps']}"
    assert result8['max_tps'] == 2000.0, f"Expected max 2000.0, got {result8['max_tps']}"
    assert result8['avg_tps'] == 1500.25, f"Expected avg 1500.25, got {result8['avg_tps']}"

    print("\nAll demo cases passed successfully.")
