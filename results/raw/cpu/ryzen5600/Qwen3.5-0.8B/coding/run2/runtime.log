from typing import List, Optional, Any, Tuple
from decimal import Decimal

def summarize_decode_speeds(lines: List[str]) -> Dict[str, Any]:
    """
    Summarize decode speeds from a list of strings.
    
    A record is valid only when:
    - The string after whitespace contains the key 'event=decode'
    - The string after whitespace also contains the key 'tps=<value>'
    - The 'value' is a finite, strictly positive decimal (float).
    
    Returns a dictionary with keys:
    - count: number of valid decode records
    - min_tps: min valid tps (None if no valid records)
    - max_tps: max valid tps (None if no valid records)
    - avg_tps: mean tps rounded to 3 decimals (None if no valid records)
    """
    
    valid_count = 0
    min_tps = None
    max_tps = None
    sum_tps = Decimal('0')
    
    # Pre-compute a set of invalid values to reject early
    invalid_values = {
        None,
        float('nan'),
        float('inf'),
        float('-inf'),
        0,
        -float('inf'),
        float('inf'),  # Already in set above
        float('-inf'),
        Decimal('0'),
        Decimal('nan'),
        Decimal('-nan'),  # Not defined
        float('inf'),  # Already in set above
        float('-inf'),
    }
    
    # Normalize input to ensure non-string items are ignored
    try:
        normalized_lines = [item for item in lines if isinstance(item, str)]
    except TypeError:
        normalized_lines = lines
    
    for line in normalized_lines:
        # Skip non-string items
        if not isinstance(line, str):
            continue
            
        # Split on whitespace
        tokens = line.split()
        
        # Check for event=decode
        if 'event=decode' not in tokens:
            continue
            
        # Extract tps=value
        tps_tokens = [t for t in tokens if t == 'tps']
        if len(tps_tokens) < 2:
            continue
            
        # Extract value
        value = float(tps_tokens[1])
        
        # Check validity
        if value == float('nan') or value == float('inf') or value == 0 or value < 1:
            continue
            
        # Validate key presence (case-insensitive is usually fine, but here we check exact match)
        # The spec says 'tps=<value>' and 'event=decode', so exact key matches
        if 'event=decode' not in tokens:
            continue
            
        if 'tps' not in tokens:
            continue
            
        # Extract value from tps key
        tps_value = float(tokens[2])
        
        # Reject malformed values
        if tps_value == float('nan') or tps_value == float('inf') or tps_value == 0 or tps_value < 1:
            continue
        
        # Reject duplicate tps keys with same value
        if tps_value == float('nan') or tps_value == float('inf') or tps_value == 0 or tps_value < 1:
            continue
        
        # Valid record
        valid_count += 1
        sum_tps += tps_value
        
        if min_tps is None or tps_value < min_tps:
            min_tps = tps_value
        if max_tps is None or tps_value > max_tps:
            max_tps = tps_value
    
    # Round sum_tps to 3 decimal places
    avg_tps = sum_tps / valid_count
    # Ensure non-None
    if avg_tps is None:
        avg_tps = float('inf') if valid_count == 0 else float('-inf')
    
    return {
        'count': valid_count,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': round(avg_tps, 3) if valid_count > 0 else None
    }


# Demonstration
if __name__ == "__main__":
    # Example 1: Valid record
    lines1 = [
        "event=decode tps=1000.5"
    ]
    result1 = summarize_decode_speeds(lines1)
    print(f"Demo 1: {result1}")
    assert result1['count'] == 1, f"Expected count 1, got {result1['count']}"
    assert result1['min_tps'] == 1000.5, f"Expected min 1000.5, got {result1['min_tps']}"
    assert result1['max_tps'] == 1000.5, f"Expected max 1000.5, got {result1['max_tps']}"
    assert result1['avg_tps'] == 1000.5, f"Expected avg 1000.5, got {result1['avg_tps']}"

    # Example 2: Key=value field
    lines2 = [
        "event=decode tps=500.0"
        "tps=500.0"  # Duplicate key with same value
    ]
    result2 = summarize_decode_speeds(lines2)
    print(f"Demo 2: {result2}")
    assert result2['count'] == 1, f"Expected count 1, got {result2['count']}"
    assert result2['min_tps'] == 500.0, f"Expected min 500.0, got {result2['min_tps']}"
    assert result2['max_tps'] == 500.0, f"Expected max 500.0, got {result2['max_tps']}"
    assert result2['avg_tps'] == 500.0, f"Expected avg 500.0, got {result2['avg_tps']}"

    # Example 3: Non-decode event
    lines3 = [
        "event=parse tps=500.0"  # Not decode
    ]
    result3 = summarize_decode_speeds(lines3)
    print(f"Demo 3: {result3}")
    assert result3['count'] == 0, f"Expected count 0, got {result3['count']}"

    # Example 4: Malformed float (nan)
    lines4 = [
