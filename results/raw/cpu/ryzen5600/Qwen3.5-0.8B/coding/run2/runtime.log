    assert result5['count'] == 1, f"Expected count 1, got {result5['count']}"
    assert result5['min_tps'] == -500.5, f"Expected min -500.5, got {result5['min_tps']}"
    assert result5['max_tps'] == -500.5, f"Expected max -500.5, got {result5['max_tps']}"
