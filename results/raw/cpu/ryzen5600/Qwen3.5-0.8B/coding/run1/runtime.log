from typing import Any, List, Optional, Tuple, Dict

# -----------------------------------------------------------------------------
# Helper: validate float in a safe way (reject nan, inf, -inf, zero, negative)
# -----------------------------------------------------------------------------
def _is_valid_float(value: Any) -> bool:
    """
    Accept only finite, strictly positive float values.
    Reject: nan, inf, -inf, 0, negative numbers.
    """
    # Handle None/empty/inf/nan/zero/negative/complex manually
    if isinstance(value, (int, float)):
        if value == 0 or value < 0:
            return False
        # Check for inf/nan
        if value == float('inf') or value == float('-inf'):
            return False
        if value == float('nan'):
            return False
        # Check for small negative numbers (e.g. -0.001)
        if abs(value) < 1e-9:
            return False
    elif isinstance(value, str):
        # Remove surrounding whitespace first per spec
        stripped = value.strip()
        if not stripped:
            return False
        try:
            return float(stripped)
        except ValueError:
            return False
    else:
        # Unknown type
        return False


# -----------------------------------------------------------------------------
# Helper: split on whitespace and tokenize
# -----------------------------------------------------------------------------
def _split_on_whitespace(lines: List[str]) -> List[Tuple[str, str]]:
    """
    Split each line by whitespace and return a list of (token, original_line) tuples.
    Returns an empty list if any line is non-string (ignores it).
    """
    result = []
    for line in lines:
        if not isinstance(line, str):
            continue
        tokens = line.split()
        result.append((token, line))
    return result


# -----------------------------------------------------------------------------
# Helper: normalize a key-value pair
# -----------------------------------------------------------------------------
def _normalize_pair(value: Any) -> Dict[str, Any]:
    """
    Return a dict with the key-value pair normalized and checked.
    Keys must be exactly "tps" (case-sensitive).
    """
    if not isinstance(value, dict):
        return {}
    if "tps" not in value:
        return {}
    tps = value["tps"]
    if not _is_valid_float(tps):
        return {}
    return {"tps": tps}


# -----------------------------------------------------------------------------
# One-pass summary computation
# -----------------------------------------------------------------------------
def summarize_decode_speeds(lines: Any) -> Optional[Dict[str, Any]]:
    """
    One-pass algorithm to compute summary statistics over `lines`.
    
    Parameters:
        lines: iterable of strings.
    
    Returns:
        Dictionary with keys: 'count', 'min_tps', 'max_tps', 'avg_tps'.
        Each value is None when no valid records were found.
    """
    if not isinstance(lines, (list, tuple)):
        return None

    result = {}

    # Collect all valid (key, value) tuples
    # We process line by line, so this is O(n)
    tokens = _split_on_whitespace(lines)
    seen = set()  # key -> set of values that are already seen (for duplicates)

    for tok, line in tokens:
        if not tok:
            continue

        key, _ = tok
        value = _normalize_pair(value)

        # Skip if key is not exactly "tps"
        if key != "tps":
            continue

        # Skip if key is a string and not "tps"
        if isinstance(key, str) and key != "tps":
            continue

        # Skip if key is a non-string
        if isinstance(key, (int, float)):
            continue

        # Skip if key is a set (duplicate)
        if isinstance(key, set):
            continue

        if key in seen:
            continue

        # Collect this line's values for later validation
        seen.add(key)

        # Extract the tps value
        tps = value["tps"]

        # Check if this is a non-decode event (anything other than "event=decode")
        if "event" not in key:
            continue

        # Validate tps value
        if not _is_valid_float(tps):
            continue

        # tps must be a finite, strictly positive decimal
        # The spec says: "finite, strictly positive decimal"
        # float('-inf'), float('inf'), float('nan'), 0, negatives are not allowed.
        # We also reject very small negative numbers (e.g. -0.001) for consistency.
        if tps == float('inf') or tps == float('-inf') or tps == float('nan'):
            continue
        if tps <= 0:
            continue

        # Now we have a valid record
        # Record structure: {"event": "...", "tps": ...}
        # We need to extract the event string
        event = key.split("=")[0]  # take the value after "="
        record = {"event": event, "tps": tps}

        result["count"] += 1

        # Compute tps statistics
        if result["count"] > 0:
            result["min_tps"] = min(result["min_tps"], tps)
            result["max_tps"] = max(result["max_tps"], tps)
            result["avg_tps"] = round(result["avg_tps"], 3)

    # If no valid records found:
    if result["count"] == 0:
        return {"count": 0, "min_tps": None, "max_tps": None, "avg_tps": None}
    return result


