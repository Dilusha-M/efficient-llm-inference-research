from typing import Dict, Any, Iterable, Tuple
import math

def summarize_decode_speeds(lines: Iterable[str]) -> Dict[str, Any]:
    """
    Summarize decode speeds based on a list of strings.
    
    A record is valid only when, after splitting on whitespace, it contains both
    'event=decode' and a 'tps=<value>' field. The value must be a finite, strictly positive
    decimal. The result is a dictionary with keys: 'count', 'min_tps', 'max_tps', 'avg_tps'.
    
    Args:
        lines: Iterable of strings. Non-string items are ignored.
    
    Returns:
        Dictionary with count, min_tps, max_tps, and avg_tps.
    """
    valid_records: Dict[str, Tuple[float, float]] = {}  # event: (tps_min, tps_max)
    valid_records_count = 0
    result = {'count': 0, 'min_tps': None, 'max_tps': None, 'avg_tps': None}

    for line in lines:
        # Ignore non-string items
        if not isinstance(line, str):
            continue

        parts = line.split()
        event = parts[0]

        # Check for event=decode
        if event != 'decode':
            continue

        # Look for tps=<value>
        # We assume the key is tps and the value is the second part
        tps_key = parts[1]
        tps_value = parts[2]

        # Must be exactly two parts after split
        if len(parts) != 3:
            continue

        try:
            tps = float(tps_value)
        except ValueError:
            continue

        # Check for NaN, inf, -inf, zero, or negative
        if tps < 0 or tps <= 0:
            continue

        # Check for finite and strictly positive
        if not math.isfinite(tps):
            continue

        # Check for duplicate key with same value (malformed)
        if tps_key in valid_records:
            # Only ignore duplicates if the values are different
            if valid_records[tps_key][0] != tps:
                continue
            # If values are same, we assume the record is malformed (too many keys, or inconsistent)
            # In this problem statement, a duplicate key with same value is malformed
            continue

        # Record is valid
        valid_records_count += 1
        min_tps, max_tps = valid_records[tps_key]
        result['count'] = valid_records_count

        if min_tps is None:
            result['min_tps'] = tps
        if max_tps is None:
            result['max_tps'] = tps
        else:
            result['max_tps'] = max_tps

        # Calculate average if we have at least one valid record
        if valid_records_count > 0:
            avg_tps = sum(min_tps, max_tps) / valid_records_count
            result['avg_tps'] = round(avg_tps, 3)

    return result


def _demonstrate_demo():
    """
    Demonstration of the summarize_decode_speeds function with multiple cases:
    1. Valid decode record
    2. Non-decode event (malformed)
    3. Non-string item (ignored)
    4. Valid record with tps requiring rounding
    5. Malformed float
    6. Duplicate key with conflicting value
    7. Empty result case (no valid records)
    """
    # Case 1: Valid decode record with high tps
    lines = [
        "event=decode",
        "tps=100000",
        "tps=99999",
        "tps=100001",
        "tps=0",
        "tps=-50",
    ]
    result = summarize_decode_speeds(lines)
    print("Case 1 - Valid records:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")

    # Case 2: Non-decode event
    lines = [
        "event=parse",
        "tps=10000",
    ]
    result = summarize_decode_speeds(lines)
    print("\nCase 2 - Non-decode event:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")

    # Case 3: Non-string item (ignored)
    lines = [
        "event=decode",
        "tps=10000",
        "hello",
    ]
    result = summarize_decode_speeds(lines)
    print("\nCase 3 - Non-string item ignored:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")

    # Case 4: Valid record with tps requiring rounding
    lines = [
        "event=decode",
        "tps=100000.000",
    ]
    result = summarize_decode_speeds(lines)
    print("\nCase 4 - Valid record with rounding:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")

    # Case 5: Malformed float
    lines = [
        "event=decode",
        "tps=10000.5",
    ]
    result = summarize_decode_speeds(lines)
    print("\nCase 5 - Malformed float (rejected):")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")

    # Case 6: Duplicate key with conflicting value
    lines = [
        "event=decode",
        "tps=100000",
        "tps=100000",
    ]
    result = summarize_decode_speeds(lines)
    print("\nCase 6 - Duplicate key with conflicting value (rejected):")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")

    # Case 7: Empty result (no valid records)
    lines = [
        "event=parse",
        "tps=10000",
    ]
    result = summarize_decode_speeds(lines)
    print("\nCase 7 - No valid records:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")

    # Case 8: Valid record with very high tps, test min/max logic
    lines = [
        "event=decode",
