    count = len(valid_tps)
    min_tps = min(valid_tps)
    max_tps = max(valid_tps)
    avg_tps = round(sum(valid_tps) / count, 3)
    
    return {"count": count, "min_tps": min_tps, "max_tps": max_tps, "avg_tps": avg_tps}

