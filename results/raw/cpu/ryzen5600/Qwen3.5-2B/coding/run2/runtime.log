    # Actually, the logic above is getting complicated. Let's simplify.
    # We'll use a simpler two-pass approach:
    # Pass 1: Collect all tps values
    # Pass 2: Filter based on events and validate
    
    # Reset for two-pass approach
    tps_values: List[float] = []
    
    for line in lines:
        stripped = line.strip()
        if not stripped:
            continue
        tokens = stripped.split()
        
        if 'event=decode' not in tokens:
            continue
            
        # Extract all tps values
        for i, tok in enumerate(tokens):
            if tok == 'tps':
                # Check if we have a complete record
                if i + 1 >= len(tokens):
                    continue
                rest = ' '.join(tokens[i+1:])
                if rest.strip():
                    continue  # Not a complete record
            
            # Check if it's a valid tps value
            elif tok.startswith('tps='):
                value_str = tokens[i + 1]
                if not value_str:
                    continue
                
                try:
                    tps_value = float(value_str)
                    if not (isinstance(tps_value, float) and 
                            (tps_value != tps_value) and 
