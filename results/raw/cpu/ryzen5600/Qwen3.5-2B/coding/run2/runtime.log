                        continue
                except (ValueError, TypeError):
                    continue
                
                tps_values.append(tps_value)
    
    # Now filter for event=decode and valid tps
    valid_tps: List[float] = []
    for tps in tps_values:
        if tps == tps:
            valid_tps.append(tps)
    
    # Calculate stats
    if not valid_tps:
