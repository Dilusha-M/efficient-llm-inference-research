        # or a generator over tokens.
        if 'event=decode' not in tokens:
            continue
            
        has_decode = True
        # If we found 'event=decode', continue searching for 'tps=...'
        # Note: Since 'event=decode' is a prefix, any subsequent token starting with 'tps='
        # is a candidate.
        
        for i, tok in enumerate(tokens):
            if tok == 'tps':
                has_tps = True
                break
            elif tok.startswith('tps='):
                # Found tps, but we need to check the value here
                # Since we are in a loop, we can't easily backtrack to the tps token
                # without storing it. So we'll just mark it as found and break? 
                # Actually, we can't easily backtrack here without storing tokens.
                # But wait, we can just check if the current token is 'tps' and
                # the next token is a value.
                # However, a simpler approach: just collect all tps tokens and their values.
                pass
        
        # Alternative approach: use a generator to collect all tps tokens and values
        # This is more robust and doesn't require backtracking.
        pass
    
    # Let's implement the two-pass solution (which is still O(1) space)
    # Pass 1: Collect all tps tokens and values
    tps_values: List[float] = []
    
    for line in lines:
        stripped = line.strip()
        if not stripped:
            continue
        tokens = stripped.split()
        
        if 'event=decode' not in tokens:
            continue
            
        # Collect all tps tokens and values
