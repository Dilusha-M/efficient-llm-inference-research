from decimal import Decimal
import math
from typing import Iterator, Iterable, Union, Any, Dict, Optional

def summarize_decode_speeds(lines: Iterable[Union[str, Any]]) -> Dict[str, Optional[float]]:
    """
    Summarizes decode speeds from an iterable of log-like lines.
    
    Rules:
    - Each line is split on whitespace into tokens.
    - A line is a valid decode record if:
        - It contains an event token equal to "decode"
        - It contains a key "tps" with a value that parses to a finite, strictly positive float.
        - If "tps" appears multiple times with different values, the line is malformed (ignored).
        - If "tps" appears multiple times with the same value, the line is also treated as malformed (ignored).
    - Other keys/values are ignored.
    - Non-string items in the iterable are skipped.
    
    Returns a dictionary with:
        count: number of valid records
        min_tps: minimum valid tps (or None)
        max_tps: maximum valid tps (or None)
        avg_tps: arithmetic mean rounded to 3 decimal places (or None)
    """
    
    # We need to track if 'tps' key was seen in the current line.
    # Since we are doing one-pass and O(1) extra space (excluding input), 
    # we can't store all lines. We process line by line.
    # For each line, we parse tokens once.
    
    count = 0
    total_tps = 0.0
    
    for line in lines:
        # Ignore non-string items
        if not isinstance(line, str):
            continue
            
        # Tokenize
        tokens = line.split()
        
        if not tokens:
            continue
            
        # Check for event
        has_decode = "decode" in tokens
        
        if not has_decode:
            continue
            
        # Find tps value
        tps_val = None
        tps_seen = False
        
        for token in tokens:
            if token == "tps":
                if tps_seen:
                    # Duplicate key -> malformed
                    continue
                tps_seen = True
            elif tps_seen:
                # This should be the value for tps
                try:
                    val = float(token)
                    if not (math.isfinite(val) and val > 0):
                        # Invalid value -> malformed
                        continue
                except ValueError:
                    # Non-float token after tps -> malformed
                    continue
                
                # We found a valid tps
                if tps_val is None:
                    tps_val = val
                else:
                    # Second tps value found -> malformed
                    continue
        
        # If we had decode and found exactly one valid tps
        if has_decode and tps_val is not None:
            count += 1
            total_tps += tps_val
            # Update min/max on the fly
            if count == 1:
                min_tps = tps_val
                max_tps = tps_val
            else:
                if tps_val < min_tps:
                    min_tps = tps_val
                if tps_val > max_tps:
                    max_tps = tps_val
    
    if count == 0:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    
    avg_tps = round(total_tps / count, 3)
    
    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": avg_tps
    }

