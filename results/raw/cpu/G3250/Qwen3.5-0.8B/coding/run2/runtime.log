import math
from typing import Any

# ====================
# Validation helpers
# ====================

def is_valid_float(val: Any) -> bool:
    """
    Check that val is a finite, strictly positive float.
    Returns True if val == 0, negative, nan, inf, or not a float.
    """
    if not isinstance(val, (int, float)):
        return False
    if math.isnan(val) or math.isinf(val):
        return False
    if val <= 0:
        return False
    return True


def is_valid_decode_event(line: str) -> bool:
    """
    Check that a line contains both:
        - event=decode
        - and a tps=<value> field where value is a valid float.
    """
    parts = line.split()
    if len(parts) < 2:
        return False
    first = parts[0]
    if first != "event=decode":
        return False
    try:
        tps_str = parts[1]
    except (IndexError, ValueError):
        return False
    return is_valid_float(tps_str)


def validate_decode_record(line: str) -> tuple[bool, float | None]:
    """
    Validate a single line and return (is_valid, tps).
    Raises ValueError if the line is malformed.
    """
    if not is_valid_decode_event(line):
        raise ValueError(
            "Line does not contain both event=decode and a tps=<finite, strictly positive> float."
        )
    # Extract tps value
    tps_str = parts[1]
    try:
        tps = float(tps_str)
    except (ValueError, ZeroDivisionError):
        # If we reach here, we already raised ValueError above.
        # But we must still extract and return it if we want to continue.
        # For the purpose of this function, we'll just return None and raise.
        # However, to keep the function safe and return what we expect,
        # we'll raise an error here.
        raise ValueError(
            "Invalid tps value in event=decode line."
        )
    return True, tps


def summarize_decode_speeds(lines: Any) -> dict[str, Any]:
    """
    Analyze an iterable of strings and return a dictionary with:
        - count: number of valid decode records
        - min_tps: minimum valid tps, or None
        - max_tps: maximum valid tps, or None
        - avg_tps: arithmetic mean rounded to three decimal places, or None

    Returns:
        dict[str, Any]: summary statistics over the lines.

    Raises:
        ValueError: on malformed lines that should be ignored.
    """
    total = 0
    valid_records = []

    for line in lines:
        # Ignore non-string items; they are silently skipped.
        if not isinstance(line, str):
            continue

        is_valid, tps = validate_decode_record(line)
        if is_valid:
            total += 1
            valid_records.append(tps)

    if total == 0:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }

    min_tps = min(valid_records)
    max_tps = max(valid_records)
    avg_tps = sum(valid_records) / total

    # Round to 3 decimal places using Python's default behavior (64-bit float
    # has about 15-17 decimal digits of precision, so rounding to 3 is safe).
    avg_tps = round(avg_tps, 3)

    return {
        "count": total,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": avg_tps
    }


# ====================
# Demonstration
# ====================

