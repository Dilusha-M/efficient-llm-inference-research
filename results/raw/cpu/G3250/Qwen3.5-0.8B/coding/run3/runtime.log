from typing import Iterable, Optional, Dict, Tuple, Any
import math

def summarize_decode_speeds(lines: Iterable[str]) -> Dict[str, Any]:
    """
    Compute decoding speed summary from a list of strings.
    
    Each valid record must contain:
        - event = "decode"
        - tps = a finite, strictly positive float (e.g., 1.5e-5)
    
    Returns:
        dict with keys: 'count', 'min_tps', 'max_tps', 'avg_tps'
        where values are either None or rounded 3-decimal floats.
    """
    # Normalize input: ignore non-string items, treat as iterable anyway
    def process_item(item: Any) -> Tuple[bool, float]:
        # If not a string, skip and return None
        if not isinstance(item, str):
            return (False, None)
        
        # Split on whitespace
        tokens = item.split()
        
        if len(tokens) < 2:
            return (False, None)
        
        # Check required event
        if tokens[0] != "decode":
            return (False, None)
        
        # Check required tps field
        if len(tokens) < 3:
            return (False, None)
        
        tps_str = tokens[2]
        
        # Check if it's a valid finite positive float
        try:
            tps = float(tps_str)
            if tps < 0 or not isinstance(tps, (int, float)):
                return (False, None)
            # Check strictly positive
            if tps <= 0:
                return (False, None)
        except (ValueError, TypeError):
            return (False, None)
        
        return (True, tps)
    
    # Aggregate results
    results: Dict[str, Any] = {}
    events: set = set()
    valid_count = 0
    
    for line in lines:
        # Process each line, but only track relevant info
        valid, tps = process_item(line)
        
        if valid:
            events.add(event)  # Track unique decode events
            results['count'] += 1
            results['tps'] = tps
        
        # Track unique decode events globally
        if event in events:
            events.discard(event)
    
    # Handle empty results
    if not valid_count:
        min_tps = None
        max_tps = None
        avg_tps = None
    else:
        min_tps = min(results['tps'])
        max_tps = max(results['tps'])
        avg_tps = round(math.mean(results['tps']), 3) if results['tps'] else None
    
    return {
        'count': valid_count,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': avg_tps
    }


