from __future__ import annotations

import sys
from typing import Any, Iterable, Iterator

def summarize_decode_speeds(lines: Iterable[Any]) -> dict[str, Any]:
    """
    Review production-grade Python inference benchmark data.
    
    Args:
        lines: An iterable of items that should be strings.
        
    Returns:
        A dictionary with keys: count, min_tps, max_tps, avg_tps.
    """
    min_tps: float | None = None
    max_tps: float | None = None
    total_tps: float = 0.0
    count: int = 0
    
    for line in lines:
        # Requirement: Do not crash if lines contains a non-string item; ignore that item.
        if not isinstance(line, str):
            continue
            
        # Split on whitespace
        tokens: list[str] = line.split()
        
        # Requirement: Record is valid only when it contains both event=decode and a tps=<value> field.
        if len(tokens) < 2:
            continue
        
        found_decode = False
        found_tps_key = False
        found_tps_value = False
        current_tps: float | None = None
        
        # One-pass algorithm: track state for the line
        for token in tokens:
            if token.startswith("event="):
                event_value = token[6:]  # Length of "event=" is 6
                if event_value.lower() == "decode":
                    found_decode = True
                elif found_decode:
                    # Duplicate event key with conflicting value -> malformed
                    found_decode = False
                    found_tps_key = False
                    found_tps_value = False
                continue
            
            elif token.startswith("tps="):
                found_tps_key = True
                # Extract value after "tps="
                tps_str = token[4:]  # Length of "tps=" is 4
                
                # Check if there was a previous tps value (duplicate key check)
                if found_tps_key and current_tps is not None:
                    # Duplicate key with existing value -> malformed
                    found_tps_key = False
                    found_tps_value = False
                    continue
                
                # Try to parse the float
                try:
                    # Using float() which accepts decimal strings
                    current_tps = float(tps_str)
                    
                    # Check for non-finite values (nan, inf, -inf)
                    if not (current_tps != current_tps or current_tps != float('inf') or current_tps != float('-inf')):
                        # Actually, simpler check:
                        if not (current_tps != float('inf') and current_tps != float('-inf') and current_tps != float('nan')):
                            # Note: float('nan') != float('nan') is True
                            # So we can use: if not (current_tps.isfinite()):
                            pass
                    
                    # Simpler finite check using isfinite()
                    if not current_tps.isfinite():
                        continue
                    
                    # Strictly positive (greater than zero)
                    if current_tps <= 0:
                        continue
                        
                    # Found valid tps
                    found_tps_value = True
                    
                    # Update stats
                    if min_tps is None or current_tps < min_tps:
                        min_tps = current_tps
                    if max_tps is None or current_tps > max_tps:
                        max_tps = current_tps
                    total_tps += current_tps
                    count += 1
                    
                except ValueError:
                    # Malformed float
                    continue
        
        # Valid record only if both found_decode and found_tps_value are True
        # Also need to ensure we didn't have conflicting duplicates which would reset flags
        # The logic above handles: if we see a second event= or second tps=, we reset flags.
        # But we also need to ensure that the line is not malformed due to duplicate keys.
        # The reset flags logic above handles the malformed duplicate case.
        
        if found_decode and found_tps_key and found_tps_value:
            pass  # Valid record processed already
        else:
            # If we have both flags but somehow didn't process (e.g. duplicate keys reset them mid-line),
            # we need to be careful. The logic above processes valid values as they are found.
            # If a line has duplicate keys, the second occurrence resets the flags.
            # So if found_decode and found_tps_key and found_tps_value are all True at the end,
            # it means we didn't encounter conflicting duplicates that reset the flags to False.
            pass
    
    # Calculate average
    avg_tps: float | None = None
    if count > 0:
        avg_tps = round(total_tps / count, 3)
    
    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": avg_tps
    }

if __name__ == "__main__":
