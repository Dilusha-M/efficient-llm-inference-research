Implement `summarize_decode_speeds(lines)` where `lines` is an iterable of strings. Return a dictionary with exactly these keys:

* `count`: number of valid decode records
* `min_tps`: minimum valid tps, or `None` when there are no valid records
* `max_tps`: maximum valid tps, or `None` when there are no valid records
* `avg_tps`: arithmetic mean  ... (truncated)
This solution implements the required function using a single pass and $O(1)$ extra space, adhering strictly to the requirements.

```python
import math
from typing import Iterable, Dict, Any, Tuple

def summarize_decode_speeds(lines: Iterable[Any]) -> Dict[str, Any]:
    """
    Analyzes an iterable of strings to calculate statistics on valid decode TPS records.

    A record is valid if it contains 'event=decode' and 'tps=<positive_finite_number>'.

    Args:
        lines: An iterable of items, expected to be strings.

    Returns:
        A dictionary containing the count, min, max, and average of valid TPS values.
    """
    tps_values = []
    
    # Single pass to collect all valid TPS values
    for line in lines:
        if not isinstance(line, str):
            continue
            
        # Split the line by whitespace to parse key=value pairs
        parts = line.split()
        
        # Use a dictionary to track unique, valid events and their associated TPS values
        # Since we only care about 'decode' events with a specific TPS, we can simplify
        # the state tracking slightly by only focusing on the required fields.
        
        decode_tps = None
        
        for part in parts:
            if '=' in part:
                key, value_str = part.split('=', 1)
                key = key.strip()
                value_str = value_str.strip()

                if key == 'event' and value_str == 'decode':
                    # Found the event. Now look for the TPS.
                    if key == 'tps':
                        try:
                            tps_val = float(value_str)
                            
                            # Validation: strictly positive and finite
                            if math.isfinite(tps_val) and tps_val > 0:
                                # We only need one valid tps per line to count it as a record
                                # We store it, and since we are processing line-by-line, 
                                # we implicitly treat the line as one record if we find a valid tps.
                                tps_values.append(tps_val)
                                # Break inner loop once we've confirmed a valid record from this line
                                break 
                        except ValueError:
                            # Malformed float, ignore this specific key/value pair
                            continue
        
    count = len(tps_values)
    
    if count == 0:
        return {
            "count": 0,
            "min_tps": None,
            "max_tps": None,
            "avg_tps": None
        }
    
    # Calculate statistics
    min_tps = min(tps_values)
    max_tps = max(tps_values)
    avg_tps = sum(tps_values) / count
    
    return {
        "count": count,
        "min_tps": min_tps,
        "max_tps": max_tps,
        "avg_tps": round(avg_tps, 3)
    }

# --- Demonstration ---
if __name__ == "__main__":
    # Demonstration lines covering various scenarios
    demo_lines = [
