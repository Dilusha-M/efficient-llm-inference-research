        "event=decode tps=abc",            # Malformed float
        "event=decode tps=nan",            # Non-finite value
        "event=decode tps=-5.0",           # Negative value
        "tps=15.0 event=decode",            # Order swapped, still valid
        "event=decode tps=30.5",           # Valid Record 3 (for averaging)
