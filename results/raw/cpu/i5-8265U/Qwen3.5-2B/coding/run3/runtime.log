from typing import Iterable, Dict, Union

def _is_finite_positive(value: float) -> bool:
    """Check if a float is a finite, strictly positive number."""
    return not (value != value and value != float('inf')) and value > 0


def _parse_tps(token: str) -> Union[float, None]:
    """
    Parse a token like '100ms' or '500000' into a float.
    Returns None if parsing fails or if the value is not a finite positive number.
    """
    # Strip whitespace and split on whitespace
    parts = token.split()
    if not parts:
        return None

    raw_value = parts[-1]  # Assume last part is the numeric string
    try:
        parsed = float(raw_value)
    except ValueError:
        return None

    if not _is_finite_positive(parsed):
        return None

    # Ensure the value is a valid finite float (already handled by is_finite_positive)
    return parsed


def summarize_decode_speeds(lines: Iterable[str]) -> Dict[str, float]:
    """
    Summarize decode speed from a list of lines containing 'event=decode' and 'tps=<value>'.

    Returns:
        {
            'count': int,
            'min_tps': float | None,
            'max_tps': float | None,
            'avg_tps': float | None
        }
    """
    # Initialize summary with None values
    count = 0
    min_tps = None
    max_tps = None

    for token in lines:
        # Ignore non-string items
        if not isinstance(token, str):
            continue

        # Split on whitespace
        parts = token.split()
        if not parts:
            continue

        # Check for event=decode
        has_decode_event = False
        tps_token = None

        for part in parts:
            if part == 'event' and len(parts) > 1 and parts[1] == 'decode':
                has_decode_event = True

        if not has_decode_event:
            continue

        # Locate 'tps=' in the rest of the tokens
        tps_found = False
        for i, part in enumerate(parts[1:], start=1):
            if part.startswith('tps='):
                tps_token = part
                tps_found = True
                break

        if not tps_found:
            continue

        # Parse the tps value
        tps = _parse_tps(tps_token)
        if tps is None:
            continue

        # Only count if tps is strictly positive
        if not tps > 0:
            continue

        count += 1
        if min_tps is None or tps < min_tps:
            min_tps = tps
        if max_tps is None or tps > max_tps:
            max_tps = tps

    avg_tps = None
    if count > 0:
        avg_tps = sum_tps(count, min_tps, max_tps)

    return {
        'count': count,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': avg_tps
    }


def sum_tps(count: int, min_tps: float, max_tps: float) -> float:
    """
    Calculate average TPS.
    Returns None if there are no valid records.
    """
    if count == 0:
        return None
    return (min_tps + max_tps) / 2


