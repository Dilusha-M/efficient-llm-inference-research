    # 7. Non-string item (ignore)
    case7 = make_case(
        "Non-string item",
        ["event=decode", "tps=300", "text", 123, "another", "another text"]
    )

    # 8. Valid record with rounded tps (e.g., 100.5)
    case8 = make_case(
        "Valid record with rounded tps",
        ["event=decode", "tps=100.5ms", "data"]
    )

    # Collect results
