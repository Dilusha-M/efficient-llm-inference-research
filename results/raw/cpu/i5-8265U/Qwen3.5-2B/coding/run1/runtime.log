```python
from typing import Dict, Any, Iterable, Union

def summarize_decode_speeds(lines: Iterable[str]) -> Dict[str, Any]:
    """
    Summarize decode speeds from an iterable of lines.
    
    A record is valid only when:
      - It contains 'event=decode' and 'tps=<value>'
      - <value> is a finite, strictly positive decimal (float)
      - No duplicates for the same key-value
    
    Returns a dict with:
      count: int
      min_tps: float or None
      max_tps: float or None
      avg_tps: float or None (rounded to 3 decimals)
    
    Uses a one-pass O(1) extra space algorithm.
    """
    
    # Use a dictionary to track seen tps for this file
    seen_tps: Dict[str, float] = {}
    
    count = 0
    min_tps: float = None
    max_tps: float = None
    sum_tps = 0.0
    
    for item in lines:
        # Handle non-string items gracefully by skipping
        if not isinstance(item, str):
            continue
        
        line = item.strip()
        
        # Check if line is empty
        if not line:
            continue
        
        # Split on whitespace to get tokens
        tokens = line.split()
        
        # Check if 'event=decode' exists
        event_tokens = [t for t in tokens if t.startswith('event=')]
        
        if not event_tokens:
            # No decode event found, skip line
            continue
        
        event_value = event_tokens[0].split('=')[1]
        
        # If event is not 'decode', skip
        if event_value != 'decode':
            continue
        
        # Extract tps value
        tps_tokens = [t for t in tokens if t.startswith('tps=')]
        
        if not tps_tokens:
            continue
        
        tps_value_str = tps_tokens[0].split('=')[1]
        
        try:
            tps_value = float(tps_value_str)
        except ValueError:
            # Non-finite or invalid float (e.g., "nan", "inf", "-inf", "abc")
            continue
        
        # Check for zero or negative
        if tps_value <= 0:
            continue
        
        # Check for duplicates with conflicting values
        if tps_value in seen_tps:
            continue
        
        # Record the valid tps
        seen_tps[tps_value] = seen_tps.get(tps_value, 0) + 1
        
        count += 1
        sum_tps += tps_value
        
        if min_tps is None or tps_value < min_tps:
            min_tps = tps_value
        if max_tps is None or tps_value > max_tps:
            max_tps = tps_value
    
    # Compute averages
    if count > 0:
        avg_tps = round(sum_tps / count, 3)
        min_tps = min_tps
        max_tps = max_tps
    else:
        avg_tps = min_tps = max_tps = None
    
    return {
        'count': count,
        'min_tps': min_tps,
        'max_tps': max_tps,
        'avg_tps': avg_tps
    }


if __name__ == "__main__":
    # Demonstration with 8 lines covering various cases
    demo_lines = [
        # Valid record: tps=100.0
        'event=decode tps=100.0',
        
        # Key=value field (no decode event, should be ignored)
        'event=other_field value=hello',
        
        # Non-decode event
        'event=other',
        
        # Malformed float: 0
        'event=decode tps=0',
        
        # Malformed float: nan
        'event=decode tps=nan',
        
        # Duplicate key with same value (malformed): tps=100.0
        'event=decode tps=100.0',
        
        # Non-string item (should be ignored)
        'event=decode tps=200.0',  # This line is ignored because it's not a string
        'event=decode tps=200.0',
        
        # Valid record whose tps requires rounding (e.g., 0.123456)
        'event=decode tps=123456.0',
    ]
    
    result = summarize_decode_speeds(demo_lines)
    
    print(f"Demo Summary:")
    print(f"  count: {result['count']}")
    print(f"  min_tps: {result['min_tps']}")
    print(f"  max_tps: {result['max_tps']}")
    print(f"  avg_tps: {result['avg_tps']}")
    
    # Expected behavior based on the logic:
    # - Lines with 'event=decode' and valid positive tps are counted.
    # - Duplicate tps=100.0 (twice) should be ignored because of duplicate key.
    # - Non-decode events and non-string items are ignored.
    # - Malformed floats (0, nan) are ignored.
    
