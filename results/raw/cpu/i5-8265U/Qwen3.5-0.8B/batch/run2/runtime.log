### Task 3 — robust aggregation:
**Pseudocode:**
```python
import collections
import random

def validate_decode_speeds(speeds):
    # Ensure speeds are numeric and positive
    speeds = [float(s) for s in speeds]
    
    # Remove duplicates to avoid duplicate processing
    unique_speeds = set(speeds)
    
    # Filter out invalid runs (e.g., negative or non-numeric)
    successful_runs = [s for s in speeds if isinstance(s, (int, float)) and s > 0]
    
    # Calculate median of successful runs
    if len(successful_runs) < 2:
        # If fewer than two successful runs, default to the median of the "failed" group (all 0)
        # or report "No data available" if we strictly require >=2
        median = 0.0 if len(successful_runs) == 0 else sorted(successful_runs)[len(successful_runs)//2]
    else:
        median = sorted(successful_runs)[len(successful_runs)//2]
    
    return median

def report_failed_run(run_id, speeds):
    return f"Failed run {run_id}: Speeds = {speeds}"

def report_median_result(successes, failed_count, failed_run_ids):
    # Report if fewer than two runs succeed
    if len(successes) < 2:
        return f"Reported median from {len(successes)} runs (all failed). Report: {', '.join(failed_run_ids)}."
    else:
        return f"Median of {len(successes)} successful runs: {sorted(successes)[len(successes)//2]}"
```
*Note: The pseudocode ensures that if fewer than two runs succeed, the failure is treated as an input issue (e.g., "no data"), rather than a zero-speed event, and the median is computed from the successful subset.*

